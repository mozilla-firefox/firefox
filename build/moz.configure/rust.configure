    "CARGO_PROFILE_RELEASE_BUILD_OVERRIDE_TRIM_PATHS", cargo_build_override_trim_paths
)
set_config(
    "CARGO_PROFILE_DEV_BUILD_OVERRIDE_TRIM_PATHS", cargo_build_override_trim_paths
