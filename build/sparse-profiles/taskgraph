# for new-style try pushes
path:try_task_config.json

# app-services tooling and their dependencies
path:services/app-services-tools/embedded-uniffi-bindgen
path:services/app-services-tools/nimbus-fml
path:Cargo.lock
path:intl/icu_segmenter_data
path:third_party/application-services/tools/embedded-uniffi-bindgen
