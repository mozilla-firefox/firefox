<resources>
  <!-- Text shown in a menu item indicating that this is a new item in the menu. -->
  <string name="mozac_menu_item_new_indicator_label">New</string>
  <!-- Text shown in a menu item indicating that this is a new item in the menu, displayed in all capital letters. -->
  <string name="mozac_menu_item_new_indicator_label_2">NEW</string>
  <!-- Content description (not visible, for screen readers etc.) for the button that dismisses the banner shown in the menu -->
  <string name="mozac_menu_banner_dismiss_description">Dismiss promotion</string>
  <!-- Instruction text telling the user they can reorder menu sections by dragging them -->
  <string name="mozac_menu_customize_drag_to_reorder">Drag sections to reorder</string>
  <!-- Button text to preview the changes made to the menu -->
  <string name="mozac_menu_customize_preview">Preview</string>
  <!-- Header text for the section containing hidden menu items -->
  <string name="mozac_menu_customize_hidden_sections">Hidden sections</string>
  <!-- Instruction telling the user that sections dragged to the Hidden area will no longer appear on the menu -->
  <string name="mozac_menu_customize_drag_to_hide">Drag sections here to hide</string>
  <!-- Button text to reset the menu to default configuration -->
  <string name="mozac_menu_customize_reset_to_default">Reset to default</string>
  <!-- Title of the dialog shown when resetting the menu to its default layout (removing all user customizations) -->
  <string name="mozac_menu_customize_reset_dialog_title">Reset to default menu?</string>
  <!-- Message of the dialog shown when resetting the menu to its default layout (removing all user customizations) -->
  <string name="mozac_menu_customize_reset_dialog_message">This removes customizations and can’t be undone.</string>
  <!-- Primary button on the menu reset dialog. Tapping it removes all user customizations. -->
  <string name="mozac_menu_customize_reset_dialog_reset">Reset</string>
  <!-- Secondary button on the menu reset dialog. Tapping it cancels the reset process and preserves all user-made customizations. -->
  <string name="mozac_menu_customize_reset_dialog_cancel">Cancel</string>
  <!-- Accessibility description used in the menu customization screen, where sections of the menu can be moved around. The string describes the section the user has selected, and tells the user what position it currently occupies. %1$s is the name of the section (e.g. "VPN"). %2$d is its position, and %3$d is the total number of sections being shown. -->
  <string name="mozac_menu_customize_shown_section">%1$s. Position %2$d of %3$d</string>
  <!-- Content description (not visible, for screen readers etc.) of a named menu section in the customize menu screen. %1$s is the name of the section, for example "Page controls", and %2$s the names of its items, for example "Back, Forward, Share, Refresh". -->
  <string name="mozac_menu_customize_named_section">Section “%1$s”: %2$s</string>
  <!-- Content description (not visible, for screen readers etc.) of a menu section without a name in the customize menu screen. %1$s is the names of its items, for example "VPN". -->
  <string name="mozac_menu_customize_unnamed_section">Section “%1$s”</string>
  <!-- Name of the action (used by screen readers, etc.) that moves a menu section up one position in the customize menu screen, or a menu item up one position on the Edit menu items screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section or a menu item. -->
  <string name="mozac_menu_customize_move_up">Move up</string>
  <!-- Name of the action (used by screen readers, etc.) that moves a menu section down one position in the customize menu screen, or a menu item down one position on the Edit menu items screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section or a menu item. -->
  <string name="mozac_menu_customize_move_down">Move down</string>
  <!-- Name of the action (used by screen readers, etc.) that hides a section in the customize menu screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section. -->
  <string name="mozac_menu_customize_hide">Hide section</string>
  <!-- Name of the action (used by screen readers, etc.) that shows a previously hidden menu section, placing it last among the visible sections in the customize menu screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section. -->
  <string name="mozac_menu_customize_unhide">Unhide section</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user moved a menu section up or down in the customize menu screen. %1$s is the name of the section, or the names of its items separated by commas if it has none, for example "Page controls", "VPN" or "Back, Forward", %2$d its new position, from 1, and %3$d the number of sections shown in the menu. -->
  <string name="mozac_menu_customize_section_moved">Section “%1$s” moved to position %2$d of %3$d</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user hid a menu section in the customize menu screen. %1$s is the name of the section, or the names of its items separated by commas if it has none, for example "Page controls", "VPN" or "Back, Forward". -->
  <string name="mozac_menu_customize_section_hidden">Section “%1$s” removed</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user showed a hidden menu section in the menu again in the customize menu screen. %1$s is the name of the section, or the names of its items separated by commas if it has none, for example "Page controls", "VPN" or "Back, Forward". -->
  <string name="mozac_menu_customize_section_shown">Section “%1$s” added to menu</string>
  <!-- Instruction text telling the user they can reorder menu items by dragging them -->
  <string name="mozac_menu_customize_drag_items_to_reorder">Drag items to reorder</string>
  <!-- Header text for the section containing menu items the user removed from the menu -->
  <string name="mozac_menu_customize_hidden_items">Hidden items</string>
  <!-- Instruction telling the user that menu items dragged to the Hidden items area will no longer appear on the menu -->
  <string name="mozac_menu_customize_drag_items_to_hide">Drag items here to hide</string>
  <!-- Customize menu screen: Name of the action, read by screen readers, for opening the screen where the items of a menu section can be changed. -->
  <string name="mozac_menu_customize_edit_items">Edit menu items</string>
  <!-- Accessibility description used in the screen where the items of a menu section can be moved around. The string describes the item the user has selected, and tells the user what position it currently occupies. %1$s is the name of the item (e.g. "Settings"). %2$d is its position, and %3$d is the total number of items being shown, including the ones inside an expanded item. -->
  <string name="mozac_menu_customize_shown_item">%1$s. Position %2$d of %3$d</string>
  <!-- Customize menu items screen: Name of the action for showing the items inside a collapsed menu item (e.g. "More"). Offered to screen readers as an action of a menu item. -->
  <string name="mozac_menu_customize_expand">Expand</string>
  <!-- Customize menu items screen: Name of the action for hiding the items inside an expanded menu item (e.g. "More"). Offered to screen readers as an action of a menu item. -->
  <string name="mozac_menu_customize_collapse">Collapse</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user expanded a menu item. %1$s is the name of the item, for example "More". If gender is ambiguous or an issue, this can also be translated as "%1$s, item expanded". -->
  <string name="mozac_menu_customize_item_expanded">%1$s expanded</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user collapsed a menu item. %1$s is the name of the item, for example "More". If gender is ambiguous or an issue, this can also be translated as "%1$s, item collapsed". -->
  <string name="mozac_menu_customize_item_collapsed">%1$s collapsed</string>
  <!-- Announcement (not visible, for screen readers etc.) when the user moves a menu item. %1$s is the name of the item, for example "Bookmarks". %2$d is its new position, and %3$d is the total number of items being shown. If gender is an issue, can also be translated as "Item %1$s moved to position %2$d of %3$d". -->
  <string name="mozac_menu_customize_item_moved">%1$s moved to position %2$d of %3$d</string>
  <!-- Announcement (not visible, for screen readers etc.) when the user changes the position of items within a menu section. %1$s is the name of the moved item, for example "Bookmarks". %2$d is its new position, and %3$d is the total number of items in the section. %4$s is the name of the section, for example "More". If gender or inflection are an issue, can also be translated as "Item %1$s moved to position %2$d of %3$d in section %4$s". -->
  <string name="mozac_menu_customize_sub_item_moved">%1$s moved to position %2$d of %3$d in %4$s</string>
  <!-- Customize menu items screen: Name of the action for removing a menu item from the menu (moving it to the "Hidden items" area). Offered to screen readers as an action of a menu item. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu item. -->
  <string name="mozac_menu_customize_hide_item">Hide item</string>
  <!-- Customize menu items screen: Name of the action for displaying a menu item that was hidden (moving it out of the "Hidden items" area). Offered to screen readers as an action of a menu item. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu item. -->
  <string name="mozac_menu_customize_unhide_item">Unhide item</string>
  <!-- Announcement (not visible, for screen readers etc.) when the user hides an item from the menu, which moves it to the "Hidden items" area. %1$s is the name of the item, for example "Bookmarks". Can also be translated as "%1$s item hidden from menu". -->
  <string name="mozac_menu_customize_item_hidden">%1$s hidden from menu</string>
  <!-- Announcement (not visible, for screen readers etc.) when the user un-hides a menu item so it is displayed in the menu again. %1$s is the name of the item, for example "Bookmarks". Can also be translated as "%1$s item added to menu". -->
  <string name="mozac_menu_customize_item_shown">%1$s added to menu</string>
  <!-- Customize menu items screen: Accessibility label (used by screenreaders) for the action of moving one menu item into another section of the menu (i.e. into a menu item that can be expanded and collapsed). It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu item. %1$s is the name of the new section that the item is moved to, for example "More". Can also be translated as 'Move into “%1$s” section'. -->
  <string name="mozac_menu_customize_move_into">Move into “%1$s”</string>
  <!-- Customize menu items screen: Accessibility label (used by screenreaders) for the action of moving a menu item out of its current menu section and into the main menu. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu item. %1$s is the name of the section the item is currently in, for example "More". Can also be translated as 'Move out of “%1$s” section'. -->
  <string name="mozac_menu_customize_move_out_of">Move out of “%1$s”</string>
  <!-- Announcement (not visible, for screen readers etc.) when the user moves a menu item into another menu section. %1$s is the name of the moved item, for example "Bookmarks". %2$s is the name of the section the item was moved to, for example "More". Can also be translated as '%1$s item moved into “%2$s” section'. -->
  <string name="mozac_menu_customize_item_moved_into">%1$s moved into “%2$s”</string>
  <!-- Announcement (not visible, for screen readers etc.) when the user moves a menu item out of the section that contains it. %1$s is the name of the moved item, for example "Bookmarks". %2$s is the name of the section it was moved out of, for example "More". Can also be translated as '%1$s item moved out of “%2$s” section'. -->
  <string name="mozac_menu_customize_item_moved_out_of">%1$s moved out of “%2$s”</string>
</resources>
