<resources>
  <!-- Text shown in a menu item indicating that this is a new item in the menu. -->
  <string name="mozac_menu_item_new_indicator_label">חדש</string>
  <!-- Text shown in a menu item indicating that this is a new item in the menu, displayed in all capital letters. -->
  <string name="mozac_menu_item_new_indicator_label_2">חדש</string>
  <!-- Content description (not visible, for screen readers etc.) for the button that dismisses the banner shown in the menu -->
  <string name="mozac_menu_banner_dismiss_description">סגירת ההצעה</string>
  <!-- Instruction text telling the user they can reorder menu sections by dragging them -->
  <string name="mozac_menu_customize_drag_to_reorder">ניתן לגרור מקטעים כדי לסדר מחדש</string>
  <!-- Button text to preview the changes made to the menu -->
  <string name="mozac_menu_customize_preview">תצוגה מקדימה</string>
  <!-- Header text for the section containing hidden menu items -->
  <string name="mozac_menu_customize_hidden_sections">מקטעים מוסתרים</string>
  <!-- Instruction telling the user that sections dragged to the Hidden area will no longer appear on the menu -->
  <string name="mozac_menu_customize_drag_to_hide">ניתן לגרור מקטעים לכאן כדי להסתיר</string>
  <!-- Button text to reset the menu to default configuration -->
  <string name="mozac_menu_customize_reset_to_default">איפוס לברירת מחדל</string>
  <!-- Title of the dialog shown when resetting the menu to its default layout (removing all user customizations) -->
  <string name="mozac_menu_customize_reset_dialog_title">לאפס את התפריט לברירת המחדל?</string>
  <!-- Message of the dialog shown when resetting the menu to its default layout (removing all user customizations) -->
  <string name="mozac_menu_customize_reset_dialog_message">פעולה זו מסירה את ההתאמות האישיות ולא ניתן לבטל אותה.</string>
  <!-- Primary button on the menu reset dialog. Tapping it removes all user customizations. -->
  <string name="mozac_menu_customize_reset_dialog_reset">איפוס</string>
  <!-- Secondary button on the menu reset dialog. Tapping it cancels the reset process and preserves all user-made customizations. -->
  <string name="mozac_menu_customize_reset_dialog_cancel">ביטול</string>
  <!-- Accessibility description used in the menu customization screen, where sections of the menu can be moved around. The string describes the section the user has selected, and tells the user what position it currently occupies. %1$s is the name of the section (e.g. "VPN"). %2$d is its position, and %3$d is the total number of sections being shown. -->
  <string name="mozac_menu_customize_shown_section">%1$s. מיקום %2$d מתוך %3$d</string>
  <!-- Content description (not visible, for screen readers etc.) of a named menu section in the customize menu screen. %1$s is the name of the section, for example "Page controls", and %2$s the names of its items, for example "Back, Forward, Share, Refresh". -->
  <string name="mozac_menu_customize_named_section">מקטע ״%1$s״: %2$s</string>
  <!-- Content description (not visible, for screen readers etc.) of a menu section without a name in the customize menu screen. %1$s is the names of its items, for example "VPN". -->
  <string name="mozac_menu_customize_unnamed_section">מקטע ״%1$s״</string>
  <!-- Name of the action (used by screen readers, etc.) that moves a menu section up one position in the customize menu screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section. -->
  <string name="mozac_menu_customize_move_up">להזיז מעלה</string>
  <!-- Name of the action (used by screen readers, etc.) that moves a menu section down one position in the customize menu screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section. -->
  <string name="mozac_menu_customize_move_down">להזיז מטה</string>
  <!-- Name of the action (used by screen readers, etc.) that hides a section in the customize menu screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section. -->
  <string name="mozac_menu_customize_hide">הסתרת המקטע</string>
  <!-- Name of the action (used by screen readers, etc.) that shows a previously hidden menu section, placing it last among the visible sections in the customize menu screen. It is also shown in the list of actions displayed when the user long-presses the drag handle of a menu section. -->
  <string name="mozac_menu_customize_unhide">ביטול הסתרת המקטע</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user moved a menu section up or down in the customize menu screen. %1$s is the name of the section, or the names of its items separated by commas if it has none, for example "Page controls", "VPN" or "Back, Forward", %2$d its new position, from 1, and %3$d the number of sections shown in the menu. -->
  <string name="mozac_menu_customize_section_moved">המקטע “%1$s״ הועבר למיקום %2$d מתוך %3$d</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user hid a menu section in the customize menu screen. %1$s is the name of the section, or the names of its items separated by commas if it has none, for example "Page controls", "VPN" or "Back, Forward". -->
  <string name="mozac_menu_customize_section_hidden">המקטע ״%1$s״ הוסר</string>
  <!-- Announcement (not visible, for screen readers etc.) once the user showed a hidden menu section in the menu again in the customize menu screen. %1$s is the name of the section, or the names of its items separated by commas if it has none, for example "Page controls", "VPN" or "Back, Forward". -->
  <string name="mozac_menu_customize_section_shown">המקטע ״%1$s״ נוסף לתפריט</string>
  <!-- Instruction text telling the user they can reorder menu items by dragging them -->
  <string name="mozac_menu_customize_drag_items_to_reorder">ניתן לגרור פריטים כדי לסדר מחדש</string>
  <!-- Header text for the section containing menu items the user removed from the menu -->
  <string name="mozac_menu_customize_hidden_items">פריטים מוסתרים</string>
  <!-- Instruction telling the user that menu items dragged to the Hidden items area will no longer appear on the menu -->
  <string name="mozac_menu_customize_drag_items_to_hide">ניתן לגרור פריטים לכאן כדי להסתיר</string>
  <!-- Customize menu screen: Name of the action, read by screen readers, for opening the screen where the items of a menu section can be changed. -->
  <string name="mozac_menu_customize_edit_items">עריכת פריטי התפריט</string>
</resources>
