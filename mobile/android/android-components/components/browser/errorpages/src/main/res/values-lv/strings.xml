<resources>
  <!-- The button that appears at the bottom of an error page. -->
  <string name="mozac_browser_errorpages_page_refresh">Mēģināt vēlreiz</string>
  <!--
    The text shown underneath the archive button, explaining what the button does. The %1$s will be replaced by
    the app name and %2$s will be replaced by the name of the archive service as a link
  -->
  <string name="mozac_browser_errorpages_archive_description">%1$s var uzmeklēt šīs lapas agrāku versiju ar Internet Archive %2$s.</string>
  <!--
    The name of the Internet Archive service, shown as a link at the end of
    mozac_browser_errorpages_archive_description.
  -->
  <string name="mozac_browser_errorpages_archive_wayback_machine">Wayback Machine</string>
  <!-- A link, shown after no archived copy was found, that searches the web for the page instead. -->
  <string name="mozac_browser_errorpages_archive_search_web">Meklēt tīmeklī.</string>
  <!-- The document title and heading of an error page shown when a website cannot be loaded for an unknown reason. -->
  <string name="mozac_browser_errorpages_generic_title">Nevar pabeigt pieprasījumu</string>
  <!-- The error message shown when a website cannot be loaded for an unknown reason. -->
  <string name="mozac_browser_errorpages_generic_message"><![CDATA[<p>Papildu informācija par šo sarežģījumu vai kļūdu šobrīd nav pieejama.</p>]]></string>
  <!-- The document title and heading of the error page shown when a website sends back unusual and incorrect credentials for an SSL certificate. -->
  <string name="mozac_browser_errorpages_security_ssl_title">Drošais savienojums neizdevās</string>
  <!-- The text shown inside the advanced button used to expand the advanced options. It's only shown when a website has an invalid SSL certificate. -->
  <string name="mozac_browser_errorpages_security_bad_cert_advanced">Paplašināti…</string>
  <!-- The text shown inside the advanced options button used to go back. It's only shown if the user has expanded the advanced options. -->
  <string name="mozac_browser_errorpages_security_bad_cert_back">Doties atpakaļ (ieteicams)</string>
  <!-- The text shown inside the advanced options button used to bypass the invalid SSL certificate. It's only shown if the user has expanded the advanced options. -->
  <string name="mozac_browser_errorpages_security_bad_cert_accept_temporary">Pieņemt apdraudējumu un turpināt</string>
  <!-- The text shown inside the advanced button used to expand the advanced options. It's only shown when a website uses HSTS. -->
  <string name="mozac_browser_errorpages_security_bad_hsts_cert_advanced">Paplašināti…</string>
  <!-- The text shown inside the advanced options button used to go back. It's only shown if the user has expanded the advanced options. -->
  <string name="mozac_browser_errorpages_security_bad_hsts_cert_back">Doties atpakaļ</string>
  <!-- The error message shown when a website took long to load. -->
  <string name="mozac_browser_errorpages_net_timeout_message"><![CDATA[<p>Pieprasītā vietne neatbildēja uz savienojuma pieprasījumu, un pārlūks pārstāja gaidīt atbildi.</p>\n<ul>\n<li>Vai serverī varētu būt liels pieprasījumu skaits vai īslaicīgi darbības traucējumi? Vēlāk jāmēģina vēlreiz.</li>\n<li>Vai nav iespējams pārlūkot citas vietnes? jāpārbauda ierīces savienojums ar tīklu.</li>\n<li>Vai ierīci vai tīklu aizsargā ugunsmūris vai starpniekserveris? Nepareizi iestatījumi var traucēt tīmekļa pārlūkošanu.</li>\n<li>Joprojām ir sarežģījumi? Jāsazinās ar tīkla pārvaldītāju vai interneta pakalpojumu sniedzēju, lai iegūtu palīdzību.</li>\n</ul>]]></string>
  <!-- The document title and heading of the error page shown when a website cannot be loaded because the browser is in offline mode. -->
  <string name="mozac_browser_errorpages_offline_title">Bezsaistē</string>
  <!-- The error message shown when a website cannot be loaded because the browser is in offline mode. -->
  <string name="mozac_browser_errorpages_offline_message"><![CDATA[<p>Pārlūks darbojas bezsaistes režīmā un nevar savienoties ar pieprasīto vienumu.</p>\n<ul>\n<li>Vai ierīce ir savienota ar darbojošos tīklu?</li>\n<li>Jāspiež “Mēģināt vēlreiz”, lai pārslēgtos uz tiešsaistes režīmu un pārlādētu lapu.</li>\n</ul>]]></string>
  <!-- The error message shown when the Internet connection is disrupted while loading a website. -->
  <string name="mozac_browser_errorpages_net_reset_message"><![CDATA[<p>Tīkla savienojums tika pārtraukts savienojuma izveidošanas laikā. Lūgums mēģināt vēlreiz.</p>\n<ul>\n<li>Vietne varētu īslaicīgi būt nepieejama vai pārāk noslogota. Pēc kāda brīža jāmēģina vēlreiz.</li>\n<li>Ja nav iespējams ielādēt nevienu lapu, jāpārbauda ierīces datu vai Wi-Fi savienojums.</li>\n</ul>]]></string>
  <!-- The document title and heading of an error page. -->
  <string name="mozac_browser_errorpages_no_internet_title_2">Izskatās, ka ir sarežģījums ar interneta savienojumu</string>
  <!-- The document title and heading of an error page. -->
  <string name="mozac_browser_errorpages_no_internet_error_code">Kļūdas kods: NS_ERROR_OFFLINE</string>
  <string name="mozac_browser_errorpages_proxy_connection_refused_message"><![CDATA[<p>Pārlūks ir konfigurēts izmantot starpniekserveri, bet starpniekserveris atteica savienojumu.</p>\n<ul>\n<li>Vai pārlūka starpniekservera konfigurācija ir pareiza? Jāpārbauda iestatījumi un jāmēģina vēlreiz.</li>\n<li>Vai starpniekservera pakalpojums atļauj savienojumus no šī tīkla?</li>\n<li>Joprojām ir sarežģījumi? Jāsazinās ar tīkla pārvaldītāju vai interneta pakalpojuma sniedzēju, lai iegūtu palīdzību.</li>\n</ul>]]></string>
  <string name="mozac_browser_errorpages_unknown_proxy_host_message"><![CDATA[<p>Pārlūks ir konfigurēts izmantot starpniekserveri, bet to nevarēja atrast.</p>\n<ul>\n<li>Vai pārlūka starpniekservera konfigurācija ir pareiza? Jāpārbauda iestatījumi un jāmēģina vēlreiz.</li>\n<li>Vai ierīce ir savienota ar darbīgu tīklu?</li>\n<li>Joprojām ir sarežģījumi? Jāsazinās ar tīkla pārvaldītāju vai interneta pakalpojuma sniedzēju, lai iegūtu palīdzību.</li>\n</ul>]]></string>
  <!-- Button on error page for websites that do not support HTTPS when HTTPS-Only is turned on. Clicking the button allows the user to nevertheless load the website using HTTP. -->
  <string name="mozac_browser_errorpages_httpsonly_button">Doties uz HTTP vietni</string>
  <!-- Button on error page for websites that do not support HTTPS when HTTPS-Only is turned on.  Clicking the button allows the user to go back. -->
  <string name="mozac_browser_errorpages_httpsonly_back">Doties atpakaļ (ieteicams)</string>
</resources>
