<resources>
  <!-- Text for the title of an authentication dialog. -->
  <string name="mozac_feature_prompt_sign_in">Pieteikties</string>
  <!-- Text of a confirm button in dialog requesting to open a new window. -->
  <string name="mozac_feature_prompts_allow">Atļaut</string>
  <!-- Title of the dialog shown when a user is leaving a website and there is still data not saved yet. -->
  <string name="mozac_feature_prompt_before_unload_dialog_title">Vai tiešām?</string>
  <!-- Continue button label for WebAuthn related origin prompt. -->
  <string name="webauthn_continue">Turpināt</string>
  <!-- Option in expanded select password prompt that links to password settings -->
  <string name="mozac_feature_prompts_manage_logins_2">Pārvaldīt paroles</string>
  <!-- Title of dialog to store credit card information in the user's account -->
  <string name="mozac_feature_prompts_save_payment_method_prompt_title">Saglabāt šo maksājumu veidu?</string>
  <!-- Title of dialog to update stored credit card information in the user's account -->
  <string name="mozac_feature_prompts_update_payment_method_prompt_title">Atjaunināt šo maksājumu veidu?</string>
  <!-- Body of the dialog to confirm saving or updating credit card information when the "Save security codes" toggle is on. %s is the name of the app (for example "Firefox"). -->
  <string name="mozac_feature_prompts_save_payment_method_prompt_body_with_security_code">%s šifŗē kartes numuru un drošības kodu, lai vēlāk varētu veikt maksājumus ātrāk.</string>
  <!-- Body of the dialog to confirm saving or updating credit card information when the "Save security codes" toggle is off. %s is the name of the app (for example "Firefox"). -->
  <string name="mozac_feature_prompts_save_payment_method_prompt_body_without_security_code">%s šifŗē kartes numuru, lai vēlāk varētu veikt maksājumus ātrāk.</string>
  <!-- Label for the masked card security code in a save or update credit card dialog. %s is the masked security code (for example "•••"). -->
  <string name="mozac_feature_prompts_save_payment_method_security_code">Drošības kods %s</string>
  <!-- Content description for the masked card security code in a save or update credit card dialog. Screen readers read it instead of the masked characters. -->
  <string name="mozac_feature_prompts_save_payment_method_security_code_description">Drošības kods paslēpts</string>
  <!-- Label of the toggle in a save or update credit card dialog that controls whether the card security code is saved. -->
  <string name="mozac_feature_prompts_always_save_security_codes">Saglabāt drošības kodus</string>
  <!-- Text for the button that closes a save or update credit card dialog without saving. -->
  <string name="mozac_feature_prompts_save_payment_method_dismiss">Noraidīt</string>
  <!-- Title of the edit credit card screen (also used as the accessibility description for the button that opens this screen). -->
  <string name="mozac_feature_prompts_edit_credit_card_title">Labot karti</string>
  <!-- Edit credit card screen - label of the credit card number field -->
  <string name="mozac_feature_prompts_edit_credit_card_number">Kartes numurs</string>
  <!-- Edit credit card screen - Error message displayed for the credit card number field -->
  <string name="mozac_feature_prompts_edit_credit_card_number_error">Jāievada derīgs kartes numurs</string>
  <!-- Edit credit card screen - label of the cardholder name field -->
  <string name="mozac_feature_prompts_edit_credit_card_name">Vārds uz kartes</string>
  <!-- Edit credit card screen - label for the credit card expiration date field (month only) -->
  <string name="mozac_feature_prompts_edit_credit_card_expiry_month">Beigu datuma mēnesis</string>
  <!-- Edit credit card screen - format for options in the month dropdown: %1$s is the name of the month (for example "January"), and %2$s is the month number with two digits (for example "01"). The result would be "January (01)". -->
  <string name="mozac_feature_prompts_edit_credit_card_expiry_month_option">%1$s (%2$s)</string>
  <!-- Edit credit card screen - label for the credit card expiration date field (year only) -->
  <string name="mozac_feature_prompts_edit_credit_card_expiry_year">Beigu datuma gads</string>
  <!-- Edit credit card screen - label for the credit card security code field (CVV is the common short form in English and stands for Card Verification Value) -->
  <string name="mozac_feature_prompts_edit_credit_card_security_code">CVV (izvēles)</string>
  <!-- Edit credit card screen - Error message for the security code field when the entered code is too short. -->
  <string name="mozac_feature_prompts_edit_credit_card_security_code_error">Jāievada 3 vai 4 ciparu drošības kods</string>
  <!-- Edit credit card screen - Accessibility description of the button that clears the security code field -->
  <string name="mozac_feature_prompts_edit_credit_card_security_code_clear">Notīrīt drošības kodu</string>
  <!-- Title of an account picker dialog for identity credentials. The %1$s will be replaced with the name of the provider -->
  <string name="mozac_feature_prompts_identity_credentials_choose_account_for_provider">Pieteikties ar %1$s kontu</string>
  <!-- Text for the positive button of the Identity Credential dialogs. -->
  <string name="mozac_feature_prompts_identity_credentials_continue">Turpināt</string>
</resources>
