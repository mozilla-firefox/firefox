  <string name="mozac_feature_applinks_normal_confirm_dialog_title">باز کردن در برنامه دیگر</string>
  <!-- The title of the prompt that warns users their normal browsing session is trying to open another app -->
  <string name="mozac_feature_applinks_normal_confirm_dialog_title_2">این پیوند در برنامهٔ دیگری باز شود؟</string>
  <!--
    The title of the prompt with app suffix.
    %s is a placeholder that will be replaced by an app name
  -->
