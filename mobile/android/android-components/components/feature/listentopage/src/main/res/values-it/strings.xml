<resources>
  <plurals name="mozac_feature_listentopage_notification_skip_back">
    <!--
      Content description of the playback notification control that moves the
      reading backwards. %1$d is how many seconds it moves by.
    -->
    <item quantity="one">Indietro %1$d secondo</item>
    <item quantity="other">Indietro %1$d secondi</item>
  </plurals>
  <plurals name="mozac_feature_listentopage_notification_skip_forward">
    <!--
      Content description of the playback notification control that moves the
      reading forwards. %1$d is how many seconds it moves by.
    -->
    <item quantity="one">Avanti %1$d secondo</item>
    <item quantity="other">Avanti %1$d secondi</item>
  </plurals>
  <!-- Listen to Page media player: screen reader value of the playback position slider, such as "3:34 of 6:00". %1$s is the elapsed time and %2$s is the total duration. -->
  <string name="mozac_feature_listentopage_seek_state">%1$s di %2$s</string>
  <!-- Content description of the playback control notification, when the playback is set to 0.25 times the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_0_25">Velocità di riproduzione ridotta del 75%%</string>
  <!-- Content description of the playback control notification, when the playback is set to 0.5 times (half) the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_0_5">Riproduzione impostata a metà velocità</string>
  <!-- Content description of the playback control notification, when the playback is set to 0.75 times the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_0_75">Velocità di riproduzione ridotta del 25%%</string>
  <!-- Content description of the playback control notification, when the playback is set to normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_1">Velocità di riproduzione normale</string>
  <!-- Content description of the playback control notification, when the playback is set to 1.25 times the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_1_25">Velocità di riproduzione aumentata del 25%%</string>
  <!-- Content description of the playback control notification, when the playback is set to 1.5 times the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_1_5">Velocità di riproduzione aumentata del 50%%</string>
  <!-- Content description of the playback control notification, when the playback is set to 1.75 times the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_1_75">Velocità di riproduzione aumentata del 75%%</string>
  <!-- Content description of the playback control notification, when the playback is set to 2 times (double) the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_2">Riproduzione impostata al doppio della velocità</string>
  <!-- Error text shown on the Listen to Page media player when the text-to-speech engine fails to convert the article into spoken audio -->
  <string name="mozac_feature_listentopage_error_audio_not_available">Audio non disponibile</string>
  <!-- Error text shown on the Listen to Page media player when the player encounters an error partway through playing the audio. -->
  <string name="mozac_feature_listentopage_error_could_not_finish_playing_audio">Impossibile completare la riproduzione dell’audio. Riprova.</string>
  <!-- Error text shown on the Listen to Page media player when no voice options are available to play the audio. -->
  <string name="mozac_feature_listentopage_error_voice_options_not_available">Nessuna opzione vocale disponibile</string>
  <!-- Title of the Listen to page lock-screen notification: displayed instead of the page title, when the page being read is in a Private tab (to protect the user's privacy) -->
  <string name="mozac_feature_listentopage_private_tab_title">Scheda anonima</string>
  <!-- Message of the Listen to page lock-screen notification: displayed instead of the page URL, when the page being read is in a Private tab (to protect the user's privacy) -->
  <string name="mozac_feature_listentopage_private_tab_site">Sito web nascosto</string>
  <!-- Listen to Page media player: content description for the button that closes the player. -->
  <string name="mozac_feature_listentopage_close">Chiudi</string>
  <!-- Listen to Page media player: content description for the button that opens the list of available voices. -->
  <string name="mozac_feature_listentopage_voice_options">Opzioni voce</string>
  <!-- Listen to Page media player: content description for the button that opens the list of playback speeds. -->
  <string name="mozac_feature_listentopage_playback_speed">Velocità di riproduzione</string>
  <!-- Listen to Page media player: screen reader state of the voice while its menu is closed. -->
  <string name="mozac_feature_listentopage_dropdown_voice_collapsed">Raggruppato</string>
  <!-- Listen to Page media player: screen reader state of the playback speed button while its menu is closed. %1$s is the selected speed. -->
  <string name="mozac_feature_listentopage_playback_speed_collapsed">%1$s, raggruppato</string>
  <!-- Listen to Page media player: screen reader state of the voice and playback speed buttons while their menu is open. -->
  <string name="mozac_feature_listentopage_dropdown_expanded">Espanso</string>
  <!-- Listen to Page compact player: accessibility action read by screen readers for the article title, such as "Double tap to expand player". -->
  <string name="mozac_feature_listentopage_expand_player">espandere il lettore</string>
  <!-- Listen to Page media player: content description for the button that opens the list of available voices. -->
  <string name="mozac_feature_listentopage_audio">Audio</string>
  <!-- Listen to Page media player: content description for the button that rewinds 10 seconds. -->
  <string name="mozac_feature_listentopage_back_10_sec">Torna indietro di 10 secondi</string>
  <!-- Listen to Page media player: content description for play/pause button when the player is paused - tapping restarts playback. -->
  <string name="mozac_feature_listentopage_play">Riproduci</string>
  <!-- Listen to Page media player: content description for play/pause button when the player is playing - tapping pauses playback. -->
  <string name="mozac_feature_listentopage_pause">Metti in pausa</string>
  <!-- Listen to Page media player: content description for the button that Fast-forwards 30 seconds. -->
  <string name="mozac_feature_listentopage_forward_30_sec">Avanza di 30 secondi</string>
  <!-- Listen to Page media player: accessibility playback control notification that announces playback is set to normal reading speed. -->
  <string name="mozac_feature_listentopage_playback_speed_1">Velocità di riproduzione normale</string>
  <!--
    Listen to Page media player: content description for the playback speed button. Pressing it cycles through available playback speeds.
    This string will be interpolated into a longer message, equivalent to "Double tap to [change playback speed]" in English.
    Structure and phrasing vary by target language: using an infinitive/dictionary form of the verb is recommended.
  -->
  <string name="mozac_feature_listentopage_change_speed">cambiare la velocità di riproduzione</string>
  <!-- Playback speed menu item, such as "1.5×". %1$s is the multiplier already formatted with the decimal separator of the locale. -->
  <string name="mozac_feature_listentopage_playback_speed_option">%1$s×</string>
  <!-- Playback speed menu item for the normal reading speed, which is also the default speed. "1×" means one times the normal speed. -->
  <string name="mozac_feature_listentopage_playback_speed_option_default">1× (predefinita)</string>
</resources>
