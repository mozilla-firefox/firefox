  <string name="mozac_feature_listentopage_forward_30_sec">前进 30 秒</string>
  <!-- Listen to Page media player: accessibility playback control notification that announces playback is set to normal reading speed. -->
  <string name="mozac_feature_listentopage_playback_speed_1">正常播放速度</string>
