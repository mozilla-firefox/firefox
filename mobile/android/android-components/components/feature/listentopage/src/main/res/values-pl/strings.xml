  <string name="mozac_feature_listentopage_notification_playback_speed_0_25">Odtwarzanie wolniejsze o\u00a075 procent</string>
  <!-- Content description of the playback control notification, when the playback is set to 0.5 times (half) the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_0_5">Odtwarzanie z\u00a0połową prędkości</string>
  <!-- Content description of the playback control notification, when the playback is set to 0.75 times the normal reading speed. -->
  <string name="mozac_feature_listentopage_notification_playback_speed_0_75">Odtwarzanie wolniejsze o\u00a025 procent</string>
