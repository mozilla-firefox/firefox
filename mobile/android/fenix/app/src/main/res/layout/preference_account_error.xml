<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/account_error_background"
  android:foreground="@drawable/account_error_ripple"
  android:gravity="top"
  android:orientation="horizontal"
  android:paddingStart="12dp"
  android:paddingTop="12dp"
  android:paddingEnd="16dp"
  android:layout_marginHorizontal="16dp"
  android:paddingBottom="12dp">

  <ImageView
    android:id="@+id/account_error_icon"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:contentDescription="@null" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/account_error_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/AcornHeadline8" />

    <TextView
      android:id="@+id/account_error_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textAppearance="@style/Body14TextStyle" />

    <TextView
      android:id="@+id/account_error_action"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textAppearance="@style/Body14TextStyle" />
  </LinearLayout>
</LinearLayout>
