    to other displays.
  -->
  <string name="preference_privacy_stealth_summary">Folaigh leathanaigh Ghréasáin agus an aip á hathrú</string>
  <string name="preference_performance_block_webfonts">Cuir cosc ar chlónna Gréasáin</string>
