CPPSRCS = \
	pkixbuild.cpp \
	pkixc.cpp \
	pkixcert.cpp \
	pkixcheck.cpp \
	pkixder.cpp \
	pkixnames.cpp \
	pkixnss.cpp \
	pkixocsp.cpp \
	pkixresult.cpp \
	pkixtime.cpp \
	pkixverify.cpp \
	$(NULL)

