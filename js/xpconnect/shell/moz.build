GeckoProgram("xpcshell", linkage="dependent")

SOURCES += [
    "xpcshell.cpp",
]

if CONFIG["FUZZING_INTERFACES"]:
    if CONFIG["LIBFUZZER"]:
        USE_LIBS += ["fuzzer"]
    else:
        USE_LIBS += ["fuzzer-interface"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += [
        "xpcshellMacUtils.mm",
    ]
    SOURCE_HEADERS += [
        "xpcshellMacUtils.h",
    ]

include("/ipc/chromium/chromium-config.mozbuild")

LOCAL_INCLUDES += [
    "/toolkit/xre",
]

WIN32_WIDE_ENTRY = True
if CONFIG["CC_TYPE"] == "clang-cl":
    # Always enter a Windows program through wmain, whether or not we're
    # a console application.
    WIN32_EXE_LDFLAGS += ["-ENTRY:wmainCRTStartup"]

# DELAYLOAD_DLLS in this block ensure that the DLL blocklist initializes
if CONFIG["OS_ARCH"] == "WINNT":
    if CONFIG["MOZ_SANDBOX"]:
        # For sandbox includes and the include dependencies those have
        LOCAL_INCLUDES += [
            "/security/sandbox/chromium",
            "/security/sandbox/chromium-shim",
        ]

        OS_LIBS += [
            "advapi32",
            "shlwapi",
            "user32",
            "version",
            "winmm",
        ]

        USE_LIBS += [
            "sandbox_s",
        ]

        DELAYLOAD_DLLS += [
            "winmm.dll",
            "user32.dll",
            "userenv.dll",
        ]

    OS_LIBS += [
        "ntdll",
    ]

    DELAYLOAD_DLLS += [
        "xul.dll",
    ]

    # Don't build xpcshell.exe with CETCOMPAT, because we need to be able to
    # only enable it for processes that are not using JIT in xul.dll.
    LINK_FLAGS["CETCOMPAT"] = []

if CONFIG["OS_TARGET"] == "Darwin":
    OS_LIBS += [
        "-framework Foundation",
    ]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    CFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
    # Link Gtk+ before libxul, so that the dynamic linker loads Gtk+'s
    # dependencies, including libwayland-client, before libxul's mozwayland
    # stubs, which would otherwise take precedence and break Wayland support.
    # Firefox avoids this by loading libraries in dependentlibs.list order, see
    # toolkit/library/moz.build.
    LDFLAGS += CONFIG["MOZ_GTK3_LIBS"]
