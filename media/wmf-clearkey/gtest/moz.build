# The tested WMFClearKey*.cpp sources are included directly and use
# <initguid.h> transitively, which must not appear in a unified build.
SOURCES += [
    "TestWMFClearKeyDecryptor.cpp",
    "TestWMFClearKeySession.cpp",
]

SOURCE_HEADERS += [
    "MockSessionManagerWrapper.h",
]

LOCAL_INCLUDES += [
    "/dom/media/eme/clearkey",
    "/dom/media/platforms/wmf",
    "/media/wmf-clearkey",
]

OS_LIBS += [
    "ole32",
    "mfplat",
    "mfuuid",
]

FINAL_LIBRARY = "xul-gtest"
