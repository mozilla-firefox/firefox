UNIFIED_SOURCES += [
    "TestBuffer.cpp",
    "TestLinkedList.cpp",
    "TestReverseIterator.cpp",
    "TestSpan.cpp",
    "TestTainting.cpp",
    "TestUniquePtrExtensions.cpp",
]

SOURCES += [
    "TestFormattingAndStreaming.cpp",
]

SOURCES += [
    "TestAlgorithm.cpp",
    "TestInitializedOnce.cpp",
    "TestMainThreadWeakPtr.cpp",
    "TestResultExtensions.cpp",
]

if not CONFIG["MOZILLA_OFFICIAL"]:
    UNIFIED_SOURCES += [
        # MOZ_DBG is not defined in MOZILLA_OFFICIAL builds.
        "TestMozDbg.cpp",
    ]

# LOCAL_INCLUDES += [
#    "../../base",
# ]

# GCC has a false-positive -Wstringop-overread warning at computing the
# size of constexpr mozilla::Span.
if CONFIG["CC_TYPE"] == "gcc":
    CXXFLAGS += ["-Wno-stringop-overread"]

FINAL_LIBRARY = "xul-gtest"

LICENSED_UNDER += ["mit"]
LICENSED_UNDER["mit"].paths = [
    "TestSpan.cpp",
]
