with Files('**'):
    BUG_COMPONENT = ('Core', 'JavaScript Engine')

FINAL_LIBRARY = "mfbt"

# zmij.cc includes zmij.h, not zmij/zmij.h
LOCAL_INCLUDES += ["!.", "."]

# Suppress spurious warnings in third-party code
CXXFLAGS += [
    "-Wno-comma",
    "-Wno-stringop-overflow",
    "-Wno-unneeded-internal-declaration",
    "-Wno-unused-function",
    "-Wno-unused-variable",
]

UNIFIED_SOURCES += [
    'zmij.cc',
]
