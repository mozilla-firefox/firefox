EXPORTS += [
    'fdlibm.h',
]

Library('fdlibm')

if CONFIG['CC_TYPE'] in ('clang', 'gcc'):
    CXXFLAGS += [
        '-Wno-parentheses',
        '-Wno-sign-compare',
    ]

if CONFIG['CC_TYPE'] == 'clang':
    CXXFLAGS += [
        '-Wno-dangling-else',
        '-Wno-unsequenced',
    ]

if CONFIG['CC_TYPE'] == 'clang-cl':
    CXXFLAGS += [
        '-Wno-sign-compare',
        '-Wno-unsequenced',
        '-wd4146', # unary minus operator applied to unsigned type
        '-wd4305', # truncation from 'double' to 'const float'
        '-wd4723', # potential divide by 0
        '-wd4756', # overflow in constant arithmetic
    ]

# These sources can't be unified because there are too many conflicting global
# variables (e.g. almost every source file defines a `one` and a `huge`).
SOURCES += [
    'e_acos.cpp',
    'e_acosf.cpp',
    'e_acosh.cpp',
    'e_asin.cpp',
    'e_asinf.cpp',
    'e_atan2.cpp',
    'e_atanh.cpp',
    'e_cosh.cpp',
    'e_exp.cpp',
    'e_expf.cpp',
    'e_hypot.cpp',
    'e_hypotf.cpp',
    'e_log.cpp',
    'e_log10.cpp',
    'e_log10f.cpp',
    'e_log2.cpp',
    'e_logf.cpp',
    'e_pow.cpp',
    'e_powf.cpp',
    'e_sinh.cpp',
    'k_cos.cpp',
    'k_cosf.cpp',
    'k_exp.cpp',
    'k_expf.cpp',
    'k_rem_pio2.cpp',
    'k_sin.cpp',
    'k_sinf.cpp',
    'k_tan.cpp',
    'k_tanf.cpp',
    's_asinh.cpp',
    's_atan.cpp',
    's_atanf.cpp',
    's_cbrt.cpp',
    's_cos.cpp',
    's_cosf.cpp',
    's_exp2.cpp',
    's_exp2f.cpp',
    's_expm1.cpp',
    's_log1p.cpp',
    's_sin.cpp',
    's_sinf.cpp',
    's_tan.cpp',
    's_tanf.cpp',
    's_tanh.cpp',
]

LICENSED_UNDER += ["k_exp"]
LICENSED_UNDER["k_exp"].paths = [
    "k_exp.cpp",
]

SOURCE_HEADERS += [
	"k_log.h",
	"k_logf.h",
	"math_private.h",
]
