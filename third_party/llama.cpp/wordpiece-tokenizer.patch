Match HF tokenizers / transformers.js BERT WordPiece normalization in llama.cpp:

1. unicode_cpts_normalize_nfd was a 1:1 mapping, so a Hangul syllable kept only its
   leading jamo. Use a full canonical decomposition (Hangul algorithmic) with
   canonical ordering.
2. Strip only nonspacing marks (Mn) when strip_accents is set, as BertNormalizer
   does; \p{M} also removed spacing marks such as Indic vowel signs (Mc).
3. Words longer than max_input_chars_per_word (100) become a single [UNK].

The tables appended to unicode-data.cpp are sorted initializer_lists (constant
initialized, no static constructors). They were generated with Python 3.14
(Unicode 16.0) using `gen-unicode-data.py --wpm-tables-only`.

diff --git a/src/llama-vocab.cpp b/src/llama-vocab.cpp
index 924957674a26..a2d06df77a27 100644
--- a/src/llama-vocab.cpp
+++ b/src/llama-vocab.cpp
@@ -764,6 +764,9 @@ struct llm_tokenizer_wpm : llm_tokenizer {
 struct llm_tokenizer_wpm_session {
     llm_tokenizer_wpm_session(const llama_vocab & vocab) : vocab(vocab) {}
 
+    // HF WordPiece default; not stored in GGUF metadata
+    static constexpr size_t max_input_chars_per_word = 100;
+
     void tokenize(const std::string & text, std::vector<llama_token> & output) {
         // normalize and split by whitespace
         std::vector<std::string> words = preprocess(text, vocab.get_normalizer_opts());
@@ -776,6 +779,15 @@ struct llm_tokenizer_wpm_session {
                 continue;
             }
 
+            size_t n_chars = 0;
+            for (size_t i = 0; i < word.size(); i += unicode_len_utf8(word[i])) {
+                ++n_chars;
+            }
+            if (n_chars > max_input_chars_per_word) {
+                output.push_back(vocab.token_unk());
+                continue;
+            }
+
             // prepend phantom space
             const std::string word1 = "\xe2\x96\x81" + word;
             const int n = word1.size();
@@ -833,7 +845,8 @@ struct llm_tokenizer_wpm_session {
                 continue;
             }
 
-            if (normalizer_opts.strip_accents && flags.is_accent_mark) {
+            // BertNormalizer strips only Mn; spacing marks (Mc) such as Indic vowel signs are kept
+            if (normalizer_opts.strip_accents && flags.is_nonspacing_mark) {
                 continue;
             }
 
