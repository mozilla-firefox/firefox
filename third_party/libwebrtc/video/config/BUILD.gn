      "../../test:create_test_field_trials",
      "../../test:test_support",
      "//third_party/abseil-cpp/absl/strings:string_view",
    ]
  }

  rtc_cc_test("simulcast_unittest") {
    sources = [ "simulcast_unittest.cc" ]
    deps = [
      ":encoder_config",
      ":streams_config",
