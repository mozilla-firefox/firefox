# Defines a unit test target.
#
# This template generates:
# 1. A static library containing the test sources.
# 2. Optionally (when `rtc_build_cc_test_bins = true`), an executable to run
#    the test locally.
# 3. Metadata to ensure the test is included in at least one `rtc_test_suite`
#    (when not building with Chromium).
#
# Arguments:
#   sources: List of source files.
#   deps: List of dependencies.
#   data_deps: List of data dependencies.
#   ... (other standard rtc_library arguments)
template("rtc_cc_test") {
  _lib_target_name = "${target_name}"

  rtc_library(_lib_target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "deps",
                             "visibility",
                           ])
    testonly = true

    if (defined(invoker.deps)) {
      deps = invoker.deps
    } else {
      deps = []
    }

    # Adds a metadata key "rtc_cc_test" with a value of this test. This is used
    # to confirm this test is included in a test suite.
    metadata = {
      rtc_cc_test = [
        {
          label = get_label_info(":$_lib_target_name", "label_no_toolchain")
          type = "rtc_cc_test"
        },
      ]
    }
  }

  if (rtc_build_cc_test_bins) {
    _path_from_webrtc_root = rebase_path(".", webrtc_root)
    if (_path_from_webrtc_root == ".") {
      _binary_name = "${target_name}_bin"
    } else {
      _binary_name = string_replace(_path_from_webrtc_root, "/", "_") + "_" +
                     target_name + "_bin"
    }

    rtc_test("${target_name}_bin") {
      testonly = true

      # Output into the target's directory.
      output_name = _binary_name
      deps = [ ":${_lib_target_name}" ]
      if (defined(invoker.data_deps)) {
        data_deps = invoker.data_deps
      }
    }
  }
}

# Defines a test suite that aggregates multiple unit tests.
#
# This template is used to create "mega-targets" for CI/CQ. It collects
# dependencies (which should be rtc_cc_test targets) and verifies that
# they are reachable. The `tests_in_suites.json` file is generated by
# walking the dependency graph starting from these suites.
#
# Arguments:
#   tests: List of rtc_cc_test targets to include in this suite.
#   deps: Additional dependencies (e.g. groups of tests).
template("rtc_test_suite") {
  if (defined(invoker.testonly)) {
    testonly = invoker.testonly
  } else {
    testonly = true
  }
  _suite_name = target_name

  # This checks that all of the tests strings listed are an rtc_cc_test by
  # extracting their "rtc_cc_test" metadata into a file. This uses a simple
  # set comparison in //tools_webrtc/verify_test_suite_metadata.py.
  assert(defined(invoker.tests))

  _metadata_map = []
  _metadata_check_deps = []
  foreach(t, invoker.tests) {
    _test_label = get_label_info(t, "label_no_toolchain")
    _safe_label = string_replace(_test_label, "//", "")
    _safe_label = string_replace(_safe_label, "/", "_")
    _safe_label = string_replace(_safe_label, ":", "_")
    _output_file = "$target_gen_dir/${_suite_name}_${_safe_label}_metadata.json"
    _check_target = "${_suite_name}_${_safe_label}_check"

    generated_file(_check_target) {
      testonly = testonly
      outputs = [ _output_file ]
      data_keys = [ "rtc_cc_test" ]
      output_conversion = "json"
      deps = [ t ]
    }
    _metadata_check_deps += [ ":${_check_target}" ]
    _metadata_map += [
      {
        label = _test_label
        output = rebase_path(_output_file, root_build_dir)
      },
    ]
  }

  write_file("$target_gen_dir/${_suite_name}_metadata_map.json",
             _metadata_map,
             "json")

  action("${_suite_name}_verify_metadata") {
    testonly = testonly
    script = "//tools_webrtc/verify_test_suite_metadata.py"
    inputs = [ "$target_gen_dir/${_suite_name}_metadata_map.json" ]
    outputs = [ "$target_gen_dir/${_suite_name}_metadata.stamp" ]
    args = [
      rebase_path(inputs[0], root_build_dir),
      rebase_path(outputs[0], root_build_dir),
    ]
    deps = _metadata_check_deps
  }

  assert(!defined(invoker.deps), "rtc_test_suite does not allow deps")

  rtc_test(_suite_name) {
    testonly = true
    deps = invoker.tests
    deps += [ ":${_suite_name}_verify_metadata" ]
  }
}

# Defines a Rust library.
#
# This template wraps rust_static_library from Chromium, restricting the
# arguments to a safe subset.
template("rtc_rust_library") {
  assert(
      !defined(invoker.crate_name),
      "Custom crate_name is not allowed in WebRTC. Use webrtc::import! instead.")
  assert(
      !defined(invoker.cxx_bindings),
      "cxx_bindings are not allowed in rtc_rust_library. Use rtc_rust_cxx_bridge instead.")

  rust_static_library(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "deps",
                             "rustenv",
                           ])

    rustenv = [ "WEBRTC_GN_PREFIX=$webrtc_root" ]
    if (defined(invoker.rustenv)) {
      rustenv += invoker.rustenv
    }

    deps = [ "$webrtc_root/rust/webrtc_import" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    build_native_rust_unit_tests = false
  }
}

# Defines a Rust unit test.
template("rtc_rust_unittest") {
  if (can_build_rust_unit_tests) {
    assert(
        !defined(invoker.crate_name),
        "Custom crate_name is not allowed in WebRTC. Use webrtc::import! instead.")

    rust_unit_test(target_name) {
      forward_variables_from(invoker,
                             "*",
                             [
                               "deps",
                               "rustenv",
                             ])

      rustenv = [ "WEBRTC_GN_PREFIX=$webrtc_root" ]
      if (defined(invoker.rustenv)) {
        rustenv += invoker.rustenv
      }

      deps = [ "$webrtc_root/rust/webrtc_import" ]
      if (defined(invoker.deps)) {
        deps += invoker.deps
      }
    }
  } else {
    group(target_name) {
      testonly = true
      not_needed(invoker, "*")
    }
  }
}

# Defines a Rust CXX bridge.
#
# This template wraps rust_static_library but takes a single `source` file
# instead of a list of sources, enforcing the pattern of one bridge per target.
template("rtc_rust_cxx_bridge") {
  assert(defined(invoker.source), "source must be specified")
  assert(!defined(invoker.sources), "Use source instead of sources")

  # Explicitly assert that //build/rust:cxx_rustdeps is listed in deps.
  assert(defined(invoker.deps) &&
             filter_labels_include(invoker.deps,
                                   [ "//build/rust:cxx_rustdeps" ]) != [],
         "rtc_rust_cxx_bridge requires //build/rust:cxx_rustdeps in deps.")
  assert(
      !defined(invoker.crate_name),
      "Custom crate_name is not allowed in WebRTC. Use webrtc::import! instead.")

  rust_static_library(target_name) {
    forward_variables_from(invoker,
                           [
                             "allow_unsafe",
                             "features",
                             "edition",
                             "crate_root",
                             "testonly",
                             "visibility",
                             "deps",
                           ])
    rustenv = [ "WEBRTC_GN_PREFIX=$webrtc_root" ]
    if (defined(invoker.rustenv)) {
      rustenv += invoker.rustenv
    }
    if (!defined(deps)) {
      deps = []
    }
    deps += [ "$webrtc_root/rust/webrtc_import" ]
    if (!defined(crate_root)) {
      crate_root = invoker.source
    }
    sources = [ invoker.source ]
    cxx_bindings = [ invoker.source ]

    # WebRTC and Abseil include paths/defines are explicitly populated so that
    # auto-generated bridge C++ source files (.cc) can safely locate required
    # headers during compilation, and propagate header visibility cleanly via
    # public_configs.
    if (defined(invoker.configs)) {
      configs += invoker.configs
    }
    configs += [
      rtc_common_inherited_config,
      absl_include_config,
      absl_define_config,
    ]
    public_configs = [
      rtc_common_inherited_config,
      absl_include_config,
      absl_define_config,
    ]
    if (defined(invoker.public_configs)) {
      public_configs += invoker.public_configs
    }
  }
}

# Defines a suite of Rust unit tests.
template("rtc_rust_test_suite") {
  if (rtc_rust && can_build_rust_unit_tests) {
    rust_unit_tests_group(target_name) {
      forward_variables_from(invoker, "*")
    }
  } else {
    group(target_name) {
      testonly = true
      not_needed(invoker, "*")
    }
  }
}
