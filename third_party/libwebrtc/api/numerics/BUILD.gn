import("../../webrtc.gni")

rtc_source_set("sequence_number_unwrapper") {
  visibility = [ "*" ]
  sources = [ "sequence_number_unwrapper.h" ]
  deps = [ "../../rtc_base:sequence_number_util" ]
}

rtc_library("numerics") {
  visibility = [ "*" ]

  sources = [
    "samples_stats_counter.cc",
    "samples_stats_counter.h",
  ]
  deps = [
    "../../rtc_base:checks",
    "../../rtc_base:rtc_numerics",
    "../units:timestamp",
    "//third_party/abseil-cpp/absl/algorithm:container",
  ]
}

if (rtc_include_tests) {
  rtc_cc_test("samples_stats_counter_unittest") {
    sources = [ "samples_stats_counter_unittest.cc" ]

    deps = [
      ":numerics",
      "../../test:test_support",
      "../units:timestamp",
      "//third_party/abseil-cpp/absl/algorithm:container",
    ]
  }

  rtc_cc_test("sequence_number_unwrapper_unittest") {
    sources = [ "sequence_number_unwrapper_unittest.cc" ]

    deps = [
      ":sequence_number_unwrapper",
      "../../test:test_support",
    ]
  }
}
