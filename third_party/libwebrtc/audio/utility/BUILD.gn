import("../../webrtc.gni")

group("utility") {
  deps = [ ":audio_frame_operations" ]
}

rtc_library("audio_frame_operations") {
  visibility = [ "*" ]
  sources = [
    "audio_frame_operations.cc",
    "audio_frame_operations.h",
    "channel_mixer.cc",
    "channel_mixer.h",
    "channel_mixing_matrix.cc",
    "channel_mixing_matrix.h",
  ]

  deps = [
    "../../api/audio:audio_frame_api",
    "../../common_audio",
    "../../rtc_base:checks",
    "../../rtc_base:safe_conversions",
  ]
}

if (rtc_include_tests) {
  rtc_cc_test("audio_frame_operations_unittest") {
    sources = [ "audio_frame_operations_unittest.cc" ]
    deps = [
      ":audio_frame_operations",
      "../../api/audio:audio_frame_api",
      "../../rtc_base:checks",
      "../../test:test_support",
    ]
  }

  rtc_cc_test("channel_mixer_unittest") {
    sources = [ "channel_mixer_unittest.cc" ]
    deps = [
      ":audio_frame_operations",
      "../../api/audio:audio_frame_api",
      "../../rtc_base:stringutils",
      "../../test:test_support",
    ]
  }

  rtc_cc_test("channel_mixing_matrix_unittest") {
    sources = [ "channel_mixing_matrix_unittest.cc" ]
    deps = [
      ":audio_frame_operations",
      "../../api/audio:audio_frame_api",
      "../../rtc_base:stringutils",
      "../../test:test_support",
    ]
  }
}
