import("../../webrtc.gni")

rtc_source_set("unit_base") {
  visibility = [
    ":*",
    "../../api/units:*",
  ]
  sources = [ "unit_base.h" ]

  deps = [
    "..:checks",
    "..:divide_round",
    "..:safe_conversions",
  ]
}

if (rtc_include_tests) {
  rtc_cc_test("unit_base_unittest") {
    sources = [ "unit_base_unittest.cc" ]
    deps = [
      ":unit_base",
      "..:checks",
      "../../test:test_support",
    ]
  }
}
