From: Michael Froman <mfroman@mozilla.com>
Date: Tue, 15 Sep 2026 16:49:00 +0000
Subject: Bug 1996020 - add 2-arg version of I420Buffer::CreateOrNull, use in
 VideoFrameBuffer::CropAndScale. r=bwc

Differential Revision: https://phabricator.services.mozilla.com/D326237
Mercurial Revision: https://hg.mozilla.org/mozilla-central/rev/b19588c8c0fc39e71f452321310965ab187e1f9b
---
 api/video/i420_buffer.cc        | 5 +++++
 api/video/i420_buffer.h         | 1 +
 api/video/video_frame_buffer.cc | 5 ++++-
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/api/video/i420_buffer.cc b/api/video/i420_buffer.cc
index 2acb160b6e..6257cb6e6c 100644
--- a/api/video/i420_buffer.cc
+++ b/api/video/i420_buffer.cc
@@ -77,6 +77,11 @@ scoped_refptr<I420Buffer> I420Buffer::Create(int width, int height) {
   return make_ref_counted<I420Buffer>(width, height);
 }
 
+// static
+scoped_refptr<I420Buffer> I420Buffer::CreateOrNull(int width, int height) {
+  return I420Buffer::CreateOrNull(width, height, width, (width + 1) / 2, (width + 1) / 2);
+}
+
 // static
 scoped_refptr<I420Buffer> I420Buffer::Create(int width,
                                              int height,
diff --git a/api/video/i420_buffer.h b/api/video/i420_buffer.h
index e4935b430c..d802a8f766 100644
--- a/api/video/i420_buffer.h
+++ b/api/video/i420_buffer.h
@@ -27,6 +27,7 @@ namespace webrtc {
 class RTC_EXPORT I420Buffer : public I420BufferInterface {
  public:
   static scoped_refptr<I420Buffer> Create(int width, int height);
+  static scoped_refptr<I420Buffer> CreateOrNull(int width, int height);
   static scoped_refptr<I420Buffer> Create(int width,
                                           int height,
                                           int stride_y,
diff --git a/api/video/video_frame_buffer.cc b/api/video/video_frame_buffer.cc
index 929ff38e23..6192b11e16 100644
--- a/api/video/video_frame_buffer.cc
+++ b/api/video/video_frame_buffer.cc
@@ -35,7 +35,10 @@ scoped_refptr<VideoFrameBuffer> VideoFrameBuffer::CropAndScale(
     return nullptr;
   }
   scoped_refptr<I420Buffer> result =
-      I420Buffer::Create(scaled_width, scaled_height);
+      I420Buffer::CreateOrNull(scaled_width, scaled_height);
+  if (!result) {
+    return nullptr;
+  }
   result->CropAndScaleFrom(*i420_buffer, offset_x, offset_y, crop_width,
                            crop_height);
   return result;
