 BUILD.gn     | 4 ++++
 sdk/BUILD.gn | 6 ++++++
 2 files changed, 10 insertions(+)

diff --git a/BUILD.gn b/BUILD.gn
index 07eea067bd..6d0817fbf5 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -652,6 +652,10 @@ if (!build_with_chromium) {
       ]
     }
 
+    if (build_with_mozilla && is_mac) {
+      deps += [ "sdk:videocapture_objc" ]
+    }
+
     if (rtc_include_internal_audio_device) {
       deps += [ "api/audio:create_audio_device_module" ]
     }
diff --git a/sdk/BUILD.gn b/sdk/BUILD.gn
index 94542ac7e3..b61062967d 100644
--- a/sdk/BUILD.gn
+++ b/sdk/BUILD.gn
@@ -565,6 +565,7 @@ if (is_ios || is_mac) {
       }
     }
 
+    if (!build_with_mozilla) {
     rtc_library("videosource_objc") {
       sources = [
         "objc/api/peerconnection/RTCVideoSource+Private.h",
@@ -592,6 +593,7 @@ if (is_ios || is_mac) {
         ":used_from_extension",
       ]
     }
+    }
 
     rtc_library("videoframebuffer_objc") {
       visibility = [ "*" ]
@@ -624,6 +626,7 @@ if (is_ios || is_mac) {
       ]
     }
 
+    if (!build_with_mozilla) {
     rtc_library("metal_objc") {
       visibility = [ "*" ]
       allow_poison = [
@@ -686,6 +689,7 @@ if (is_ios || is_mac) {
         ":videoframebuffer_objc",
       ]
     }
+    }
 
     rtc_library("videocapture_objc") {
       visibility = [ "*" ]
@@ -714,6 +718,7 @@ if (is_ios || is_mac) {
       ]
     }
 
+    if (!build_with_mozilla) {
     rtc_library("videocodec_objc") {
       visibility = [ "*" ]
       configs += [ "..:no_global_constructors" ]
@@ -1830,5 +1835,6 @@ if (is_ios || is_mac) {
         "VideoToolbox.framework",
       ]
     }
+    }
   }
