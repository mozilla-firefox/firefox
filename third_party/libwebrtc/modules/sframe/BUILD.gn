    "sframe_encryptor.h",
  ]
  deps = [
    ":sframe_context_factory",
    ":sframe_media_encryptor_interface",
    "../../api:make_ref_counted",
    "../../api:rtc_error",
    "../../api:scoped_refptr",
    "../../api:sframe_types",
    "../../rtc_base:macromagic",
    "../../rtc_base:race_checker",
    "//third_party/abseil-cpp/absl/base:nullability",
    "//third_party/sframe",
  ]
}

rtc_library("synchronized_sframe_encryptor") {
  visibility = [ "*" ]
  sources = [
    "synchronized_sframe_encryptor.cc",
    "synchronized_sframe_encryptor.h",
  ]
  deps = [
    ":sframe_encryptor",
    ":sframe_media_encryptor_interface",
    "../../api:make_ref_counted",
    "../../api:rtc_error",
    "../../api:scoped_refptr",
    "../../api:sframe_types",
    "../../rtc_base/synchronization:mutex",
    "//third_party/abseil-cpp/absl/base:nullability",
  ]
}

rtc_library("sframe_media_decryptor_interface") {
