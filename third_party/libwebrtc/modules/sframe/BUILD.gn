    visibility = [ "*" ]
    testonly = true
    sources = [ "mock_sframe_media_encryptor.h" ]
    deps = [
      ":sframe_media_encryptor_interface",
      "../../api:rtc_error",
      "../../test:test_support",
    ]
  }

  rtc_cc_test("sframe_decrypt_error_reporter_unittest") {
    sources = [ "sframe_decrypt_error_reporter_unittest.cc" ]
    deps = [
      ":sframe_decrypt_error_reporter",
      "../../api:frame_transformer_interface",
      "../../api:mock_transformable_frame",
      "../../api:sframe_decryptor_interface",
      "../../test:test_support",
    ]
  }

  rtc_cc_test("sframe_encryptor_decryptor_unittest") {
    sources = [ "sframe_encryptor_decryptor_unittest.cc" ]
    deps = [
      ":sframe_decryptor",
      ":sframe_encryptor",
      ":sframe_media_decryptor_interface",
      "../../api:rtc_error",
      "../../api:scoped_refptr",
      "../../api:sframe_decryptor_interface",
      "../../api:sframe_types",
      "../../test:test_support",
    ]
  }

  rtc_cc_test("synchronized_sframe_encryptor_unittest") {
    sources = [ "synchronized_sframe_encryptor_unittest.cc" ]
    deps = [
      ":sframe_decryptor",
      ":sframe_media_decryptor_interface",
      ":synchronized_sframe_encryptor",
      "../../api:rtc_error",
      "../../api:scoped_refptr",
      "../../api:sframe_types",
      "../../rtc_base:rtc_event",
      "../../rtc_base:task_queue_for_test",
      "../../test:test_support",
    ]
  }
}
