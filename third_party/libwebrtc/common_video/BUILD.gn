import("../webrtc.gni")

rtc_library("corruption_score_calculator") {
  sources = [ "include/corruption_score_calculator.h" ]
  deps = [
    "../api/video:video_frame",
    "../api/video:video_rtp_headers",
    "../api/video/corruption_detection:frame_instrumentation_data",
  ]
}

rtc_library("common_video") {
  visibility = [ "*" ]

  sources = [
    "bitrate_adjuster.cc",
    "frame_rate_estimator.cc",
    "frame_rate_estimator.h",
    "framerate_controller.cc",
    "framerate_controller.h",
    "h264/h264_bitstream_parser.cc",
    "h264/h264_bitstream_parser.h",
    "h264/h264_common.cc",
    "h264/h264_common.h",
    "h264/pps_parser.cc",
    "h264/pps_parser.h",
    "h264/sps_parser.cc",
    "h264/sps_parser.h",
    "h264/sps_vui_rewriter.cc",
    "h264/sps_vui_rewriter.h",
    "include/bitrate_adjuster.h",
    "include/quality_limitation_reason.h",
    "include/video_frame_buffer.h",
    "include/video_frame_buffer_pool.h",
    "libyuv/include/webrtc_libyuv.h",
    "libyuv/webrtc_libyuv.cc",
    "video_frame_buffer.cc",
    "video_frame_buffer_pool.cc",
  ]

  if (rtc_use_h265) {
    sources += [
      "h265/h265_bitstream_parser.cc",
      "h265/h265_bitstream_parser.h",
      "h265/h265_common.cc",
      "h265/h265_common.h",
      "h265/h265_inline.cc",
      "h265/h265_inline.h",
      "h265/h265_pps_parser.cc",
      "h265/h265_pps_parser.h",
      "h265/h265_sps_parser.cc",
      "h265/h265_sps_parser.h",
      "h265/h265_vps_parser.cc",
      "h265/h265_vps_parser.h",
    ]
  }

  deps = [
    "../api:make_ref_counted",
    "../api:scoped_refptr",
    "../api/units:time_delta",
    "../api/units:timestamp",
    "../api/video:video_frame",
    "../api/video:video_frame_i010",
    "../api/video:video_rtp_headers",
    "../api/video_codecs:bitstream_parser_api",
    "../rtc_base:bit_buffer",
    "../rtc_base:bitstream_reader",
    "../rtc_base:buffer",
    "../rtc_base:checks",
    "../rtc_base:logging",
    "../rtc_base:macromagic",
    "../rtc_base:race_checker",
    "../rtc_base:rate_statistics",
    "../rtc_base:refcount",
    "../rtc_base:timeutils",
    "../rtc_base/synchronization:mutex",
    "../rtc_base/system:rtc_export",
    "../system_wrappers",
    "../system_wrappers:metrics",
    "//third_party/abseil-cpp/absl/base:core_headers",
    "//third_party/abseil-cpp/absl/base:nullability",
    "//third_party/abseil-cpp/absl/numeric:bits",
    "//third_party/libyuv",
  ]
  if (rtc_use_h265) {
    deps += [
      "../rtc_base:compile_assert_c",
      "../rtc_base/containers:flat_map",
    ]
  }

  if (!is_ios) {
    defines = [ "HAVE_LIBYUV_JPEG" ]
  }
}

rtc_source_set("frame_counts") {
  visibility = [ "*" ]

  sources = [ "frame_counts.h" ]
}

if (rtc_include_tests && !build_with_chromium) {
  common_video_resources = [ "../resources/foreman_cif.yuv" ]

  if (is_ios) {
    bundle_data("common_video_unittests_bundle_data") {
      testonly = true
      sources = common_video_resources
      outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
    }
  }

  rtc_cc_test("bitrate_adjuster_unittest") {
    sources = [ "bitrate_adjuster_unittest.cc" ]
    deps = [
      ":common_video",
      "../api/units:time_delta",
      "../api/units:timestamp",
      "../system_wrappers",
      "../test:test_support",
    ]
  }

  rtc_cc_test("frame_rate_estimator_unittest") {
    sources = [ "frame_rate_estimator_unittest.cc" ]
    deps = [
      ":common_video",
      "../api/units:time_delta",
      "../api/units:timestamp",
      "../system_wrappers",
      "../test:test_support",
    ]
  }

  rtc_cc_test("framerate_controller_unittest") {
    sources = [ "framerate_controller_unittest.cc" ]
    deps = [
      ":common_video",
      "../rtc_base:timeutils",
      "../test:test_support",
    ]
  }

  rtc_cc_test("h264_bitstream_parser_unittest") {
    sources = [ "h264/h264_bitstream_parser_unittest.cc" ]
    deps = [
      ":common_video",
      "../test:test_support",
    ]
  }

  rtc_cc_test("h264_common_unittest") {
    sources = [ "h264/h264_common_unittest.cc" ]
    deps = [
      ":common_video",
      "../test:test_support",
    ]
  }

  rtc_cc_test("pps_parser_unittest") {
    sources = [ "h264/pps_parser_unittest.cc" ]
    deps = [
      ":common_video",
      "../rtc_base:bit_buffer",
      "../rtc_base:buffer",
      "../rtc_base:checks",
      "../test:test_support",
    ]
  }

  rtc_cc_test("sps_parser_unittest") {
    sources = [ "h264/sps_parser_unittest.cc" ]
    deps = [
      ":common_video",
      "../rtc_base:bit_buffer",
      "../rtc_base:buffer",
      "../test:test_support",
    ]
  }

  rtc_cc_test("sps_vui_rewriter_unittest") {
    sources = [ "h264/sps_vui_rewriter_unittest.cc" ]
    deps = [
      ":common_video",
      "../api/video:video_rtp_headers",
      "../rtc_base:bit_buffer",
      "../rtc_base:buffer",
      "../test:test_support",
    ]
  }

  rtc_cc_test("webrtc_libyuv_unittest") {
    sources = [ "libyuv/webrtc_libyuv_unittest.cc" ]
    deps = [
      ":common_video",
      "../api:scoped_refptr",
      "../api/video:video_frame",
      "../api/video:video_frame_i010",
      "../api/video:video_rtp_headers",
      "../test:fileutils",
      "../test:frame_utils",
      "../test:test_support",
      "//third_party/libyuv",
    ]
    data = common_video_resources
    if (is_ios) {
      deps += [ ":common_video_unittests_bundle_data" ]
    }
  }

  rtc_cc_test("video_frame_buffer_pool_unittest") {
    sources = [ "video_frame_buffer_pool_unittest.cc" ]
    deps = [
      ":common_video",
      "../api:scoped_refptr",
      "../api/video:video_frame",
      "../api/video:video_frame_i010",
      "../test:test_support",
    ]
  }

  rtc_cc_test("video_frame_unittest") {
    sources = [ "video_frame_unittest.cc" ]
    deps = [
      ":common_video",
      "../api:scoped_refptr",
      "../api/video:video_frame",
      "../api/video:video_frame_i010",
      "../api/video:video_rtp_headers",
      "../test:frame_utils",
      "../test:test_support",
      "../test:video_test_common",
    ]
  }

  if (rtc_use_h265) {
    rtc_cc_test("h265_bitstream_parser_unittest") {
      sources = [ "h265/h265_bitstream_parser_unittest.cc" ]
      deps = [
        ":common_video",
        "../test:test_support",
      ]
    }

    rtc_cc_test("h265_pps_parser_unittest") {
      sources = [ "h265/h265_pps_parser_unittest.cc" ]
      deps = [
        ":common_video",
        "../rtc_base:bit_buffer",
        "../rtc_base:buffer",
        "../test:test_support",
      ]
    }

    rtc_cc_test("h265_sps_parser_unittest") {
      sources = [ "h265/h265_sps_parser_unittest.cc" ]
      deps = [
        ":common_video",
        "../rtc_base:bit_buffer",
        "../rtc_base:buffer",
        "../test:test_support",
      ]
    }

    rtc_cc_test("h265_vps_parser_unittest") {
      sources = [ "h265/h265_vps_parser_unittest.cc" ]
      deps = [
        ":common_video",
        "../test:test_support",
      ]
    }
  }

  rtc_test_suite("common_video_unittests") {
    testonly = true
    tests = [
      ":bitrate_adjuster_unittest",
      ":frame_rate_estimator_unittest",
      ":framerate_controller_unittest",
      ":h264_bitstream_parser_unittest",
      ":h264_common_unittest",
      ":pps_parser_unittest",
      ":sps_parser_unittest",
      ":sps_vui_rewriter_unittest",
      ":video_frame_buffer_pool_unittest",
      ":video_frame_unittest",
      ":webrtc_libyuv_unittest",
    ]

    if (rtc_use_h265) {
      tests += [
        ":h265_bitstream_parser_unittest",
        ":h265_pps_parser_unittest",
        ":h265_sps_parser_unittest",
        ":h265_vps_parser_unittest",
      ]
    }
  }
}
