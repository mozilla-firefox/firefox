      "../../api/units:time_delta",
      "../../api/units:timestamp",
      "../../rtc_base:rtc_base_tests_utils",
      "../../rtc_base:rtc_event",
      "../../rtc_base:task_queue_for_test",
      "../../rtc_base/task_utils:repeating_task",
    ]
  }

  rtc_cc_test("simulated_time_task_queue_controller_unittest") {
    sources = [ "simulated_time_task_queue_controller_unittest.cc" ]
    deps = [
      ":simulated_time_task_queue_controller",
      "../:test_support",
      "../../api/task_queue",
      "../../api/units:time_delta",
      "../../api/units:timestamp",
    ]
  }

  rtc_cc_test("time_controller_conformance_test") {
