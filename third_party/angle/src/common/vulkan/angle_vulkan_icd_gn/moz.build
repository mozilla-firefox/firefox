  ### This moz.build was AUTOMATICALLY GENERATED from a GN config,  ###
  ### DO NOT edit it by hand.                                       ###

COMPILE_FLAGS["OS_INCLUDES"] = []
AllowCompilerWarnings()

DEFINES["ANDROID"] = True
DEFINES["ANDROID_NDK_VERSION_ROLL"] = "r27_1"
DEFINES["ANGLE_DISABLE_POOL_ALLOC"] = True
DEFINES["ANGLE_ENABLE_CONTEXT_MUTEX"] = "1"
DEFINES["ANGLE_ENABLE_DEBUG_ANNOTATIONS"] = False
DEFINES["ANGLE_ENABLE_GLOBAL_MUTEX_LOAD_TIME_ALLOCATE"] = "1"
DEFINES["ANGLE_ENABLE_KEYEDMUTEX"] = True
DEFINES["ANGLE_ENABLE_SHARE_CONTEXT_LOCK"] = "1"
DEFINES["ANGLE_PLATFORM_EXPORT"] = ""
DEFINES["ANGLE_SKIP_DXGI_1_2_CHECK"] = True
DEFINES["ANGLE_USE_ANDROID_TLS_SLOT"] = "1"
DEFINES["ANGLE_VK_LAYERS_DIR"] = "\"angledata\""
DEFINES["ANGLE_VK_MOCK_ICD_JSON"] = "\"angledata/VkICD_mock_icd.json\""
DEFINES["EGL_NO_X11"] = True
DEFINES["HAVE_SYS_UIO_H"] = True
DEFINES["VK_USE_PLATFORM_ANDROID_KHR"] = True
DEFINES["_GNU_SOURCE"] = True
DEFINES["__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__"] = True
DEFINES["__STDC_CONSTANT_MACROS"] = True
DEFINES["__STDC_FORMAT_MACROS"] = True

LOCAL_INCLUDES += [
    "!/ipc/ipdl/_ipdlheaders",
    "/ipc/chromium/src",
    "/third_party/angle/include/",
    "/third_party/angle/src/",
    "/third_party/angle/src/common/base/",
    "/third_party/angle/src/common/third_party/xxhash/src/",
    "/third_party/angle/third_party/vulkan-headers/src/include/",
    "/tools/profiler/public"
]

OS_LIBS += [
    "log",
    "nativewindow"
]

UNIFIED_SOURCES += [
    "/third_party/angle/src/common/vulkan/vulkan_icd.cpp"
]

USE_LIBS += [
    "angle_common_gn",
    "angle_vulkan_headers_gn"
]

if not CONFIG["MOZ_DEBUG"]:

    DEFINES["DYNAMIC_ANNOTATIONS_ENABLED"] = "0"
    DEFINES["NDEBUG"] = True
    DEFINES["NVALGRIND"] = True

if CONFIG["MOZ_DEBUG"] == "1":

    DEFINES["ANGLE_DEBUG_LAYERS_ENABLED"] = True
    DEFINES["DYNAMIC_ANNOTATIONS_ENABLED"] = "1"
    DEFINES["_DEBUG"] = True

if CONFIG["TARGET_CPU"] == "aarch64":

    DEFINES["__ARM_NEON__"] = "1"

Library("angle_vulkan_icd_gn")
