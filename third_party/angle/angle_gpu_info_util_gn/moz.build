    DEFINES["__ANDROID_UNAVAILABLE_SYMBOLS_ARE_WEAK__"] = True
    DEFINES["__STDC_CONSTANT_MACROS"] = True
    DEFINES["__STDC_FORMAT_MACROS"] = True

    LOCAL_INCLUDES += [
        "/third_party/angle/src/third_party/khronos/",
        "/third_party/angle/third_party/vulkan-headers/src/include/"
    ]

    OS_LIBS += [
        "log",
        "nativewindow"
    ]

    UNIFIED_SOURCES += [
        "/third_party/angle/src/gpu_info_util/SystemInfo_android.cpp",
        "/third_party/angle/src/gpu_info_util/SystemInfo_vulkan.cpp"
    ]

    USE_LIBS += [
