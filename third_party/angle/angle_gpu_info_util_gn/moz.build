    DEFINES["_UNICODE"] = True
    DEFINES["_WIN32_WINNT"] = "0x0A00"
    DEFINES["_WINDOWS"] = True
    DEFINES["_WINSOCK_DEPRECATED_NO_WARNINGS"] = True
    DEFINES["__STD_C"] = True

    OS_LIBS += [
