with Files("**"):
    SCHEDULES.exclusive = ["linux", "android"]

if CONFIG["OS_ARCH"] == "Linux":
    SOURCES += [
        "NetlinkService.cpp",
    ]

    SOURCE_HEADERS += [
        "NetlinkService.h",
    ]

    if CONFIG["MOZ_ENTERPRISE"]:
        SOURCES += ["nsNetworkInterface_linux.cpp"]
        SOURCE_HEADERS += ["nsNetworkInterface_linux.h"]

# for socket
OS_LIBS += CONFIG["SOCKET_LIBS"]

FINAL_LIBRARY = "xul"
