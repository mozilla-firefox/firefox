if CONFIG["OS_ARCH"] == "WINNT":
    SOURCES += [
        "nsNotifyAddrListener.cpp",
    ]

    SOURCE_HEADERS += [
        "nsNotifyAddrListener.h",
    ]

    if CONFIG["MOZ_ENTERPRISE"]:
        SOURCES += ["nsNetworkInterface_win.cpp"]
        SOURCE_HEADERS += ["nsNetworkInterface_win.h"]

LOCAL_INCLUDES += [
    "/netwerk/base",
]

FINAL_LIBRARY = "xul"
