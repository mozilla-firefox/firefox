if CONFIG["FUZZING"]:
    SOURCES += [
        "FuzzyLayer.cpp",
        "FuzzySecurityInfo.cpp",
        "FuzzySocketControl.cpp",
    ]
    SOURCE_HEADERS += [
        "FuzzyLayer.h",
        "FuzzySecurityInfo.h",
        "FuzzySocketControl.h",
    ]

if CONFIG["FUZZING_INTERFACES"] and CONFIG["LIBFUZZER"]:
    include("/tools/fuzzing/libfuzzer-flags.mozbuild")
    SOURCES += [
        "nsURLHelper.cpp",
        "nsURLParsers.cpp",
    ]
    SOURCES["nsURLHelper.cpp"].flags += libfuzzer_flags
    SOURCES["nsURLParsers.cpp"].flags += libfuzzer_flags
else:
    UNIFIED_SOURCES += [
        "nsURLHelper.cpp",
        "nsURLParsers.cpp",
    ]


if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    SOURCES += [
        "nsURLHelperWin.cpp",
        "ShutdownLayer.cpp",
    ]
    SOURCE_HEADERS += [
        "ShutdownLayer.h",
    ]
else:
    SOURCES += [
        "nsURLHelperUnix.cpp",
    ]

