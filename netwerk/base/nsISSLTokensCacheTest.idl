#include "nsISupports.idl"

/**
 * Test-only interface for SSLTokensCache round-trip tests.
 * Implemented by mozilla::net::SSLTokensCacheService
 * (@mozilla.org/network/ssl-tokens-cache;1) when ENABLE_TESTS is set.
 */
[scriptable, uuid(7b3c4e2a-1d8f-4a5b-9c6d-2e0f1a3b5c7d)]
interface nsISSLTokensCacheTest : nsISupports {
  /** Returns the number of distinct cache keys currently in SSLTokensCache. */
  uint32_t countSSLTokens();

  /** Inserts a dummy token for aKey, for use by clearing tests. */
  void putSSLTokenForTest(in ACString aKey);

  /**
   * While aHold is true, the startup load from disk blocks before reading
   * any row. Releasing also cancels pauseLoadAfterRowsForTest. Shutdown
   * releases it. Once this or pauseLoadAfterRowsForTest was called, load
   * completion notifies "ssl-tokens-cache-load-complete-for-test".
   */
  void holdLoadForTest(in boolean aHold);

  /**
   * Blocks the startup load after aRows rows until holdLoadForTest(false).
   * Replaces a pending holdLoadForTest(true).
   */
  void pauseLoadAfterRowsForTest(in unsigned long aRows);

  /**
   * Makes the next aCount database opens for the startup load, snapshot
   * writes, clears and removals fail, as if the database were unavailable.
   * Replaces any remaining count. Once called, each removal of the database
   * after a failure notifies "ssl-tokens-cache-db-removed-for-test".
   */
  void failDBOpensForTest(in unsigned long aCount);
};
