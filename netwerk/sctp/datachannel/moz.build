with Files("**"):
    BUG_COMPONENT = ("Core", "WebRTC: Networking")

EXPORTS.mozilla.net += [
    "DataChannel.h",
    "DataChannelDcSctp.h",
    "DataChannelLog.h",
    "DataChannelProtocol.h",
]

SOURCES += [
    "DataChannel.cpp",
    "DataChannelDcSctp.cpp",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "!/dist/include/libwebrtc_overrides",
    "/dom/media/webrtc",
    "/dom/media/webrtc/transport",
    "/media/webrtc",
    "/third_party/abseil-cpp",
    "/third_party/libwebrtc",
]
