### These strings are used in the Font Inspector, a panel accessible in the
### Inspector sidebar.

# Displayed in place of the font URL when the font is installed locally on the
# system.
font-inspector-system = system
font-inspector-no-fonts-used = No fonts used on the current element.
# Tooltip for the button that copies the font URL to the clipboard.
font-inspector-copy-url-title = Copy URL

# An "instance" is the term used by font authors for a named group of
# predefined font settings, similar to a preset. This is the label of the
# dropdown used to select one.
font-inspector-font-instance-label = Instance
# Name of the entry in the instance dropdown that holds the settings manually
# adjusted by the user.
font-inspector-custom-instance-name = Custom

## Labels for the font editor controls

font-inspector-font-size-label = Size
font-inspector-font-weight-label = Weight
font-inspector-font-italic-label = Italic
font-inspector-letter-spacing-label = Spacing
font-inspector-line-height-label = Line Height

## Toggle displayed when the list of fonts used is too long to show in full.

font-inspector-show-more = Show more
font-inspector-show-less = Show less

##

font-inspector-all-fonts-on-page-header = All Fonts on Page
# Label for the list of fonts used on the selected element.
font-inspector-fonts-used-label = Fonts Used
# Placeholder for the input used to type custom text to preview fonts with.
font-inspector-preview-text-placeholder = Font Preview Text

## Labels for font metadata, displayed in the "All Fonts on Page" section.

font-inspector-font-version = Version:
font-inspector-font-designer = Designer:
font-inspector-font-manufacturer = Manufacturer:
font-inspector-font-vendor = Vendor:
font-inspector-font-description = Description:
font-inspector-font-license = License:
font-inspector-font-license-info-url = License Info URL:

##

# Button displayed to expand a truncated value (e.g. Description or License).
font-inspector-show-full-text = Expand
