# Each test renders the same file with the corresponding WebRender SVG pref on
# (test) and off (reference), so that the native WebRender rendering is
# compared against the blob image rendering. Fuzz accounts for anti-aliasing
# differences between WebRender and Skia.

defaults pref(gfx.webrender.blob.largeish-px,0) pref(gfx.webrender.blob.relaxed-active-threshold,true)

test-pref(gfx.webrender.svg-shapes.ellipses,true) ref-pref(gfx.webrender.svg-shapes.ellipses,false) fuzzy(0-80,0-2200) == shapes-ellipses.svg shapes-ellipses.svg
test-pref(gfx.webrender.svg-shapes.strokes,true) ref-pref(gfx.webrender.svg-shapes.strokes,false) test-pref(gfx.webrender.svg-shapes.ellipses,true) ref-pref(gfx.webrender.svg-shapes.ellipses,false) fuzzy(0-110,0-13377) == shapes-strokes.svg shapes-strokes.svg
test-pref(gfx.webrender.svg-text,true) ref-pref(gfx.webrender.svg-text,false) fuzzy(0-255,0-13300) == text-simple.svg text-simple.svg
test-pref(gfx.webrender.svg-text,true) ref-pref(gfx.webrender.svg-text,false) test-pref(gfx.webrender.svg-text.fill-opacity,true) ref-pref(gfx.webrender.svg-text.fill-opacity,false) fuzzy(0-170,0-7485) == text-opacity-decorations.svg text-opacity-decorations.svg
test-pref(gfx.webrender.svg-shapes.gradients,true) ref-pref(gfx.webrender.svg-shapes.gradients,false) test-pref(gfx.webrender.svg-shapes.ellipses,true) ref-pref(gfx.webrender.svg-shapes.ellipses,false) test-pref(gfx.webrender.svg-shapes.strokes,true) ref-pref(gfx.webrender.svg-shapes.strokes,false) fuzzy(0-60,0-56000) == shapes-gradients.svg shapes-gradients.svg
test-pref(gfx.webrender.svg-simple-clips,true) ref-pref(gfx.webrender.svg-simple-clips,false) test-pref(gfx.webrender.svg-mask-propagates-activity,true) ref-pref(gfx.webrender.svg-mask-propagates-activity,false) test-pref(gfx.webrender.svg-shapes.ellipses,true) ref-pref(gfx.webrender.svg-shapes.ellipses,false) test-pref(gfx.webrender.svg-shapes.strokes,true) ref-pref(gfx.webrender.svg-shapes.strokes,false) fuzzy(0-64,0-2095) == simple-clips.svg simple-clips.svg
test-pref(gfx.webrender.svg-simple-clips,true) ref-pref(gfx.webrender.svg-simple-clips,false) test-pref(gfx.webrender.svg-mask-propagates-activity,true) ref-pref(gfx.webrender.svg-mask-propagates-activity,false) test-pref(gfx.webrender.svg-text,true) ref-pref(gfx.webrender.svg-text,false) fuzzy(0-255,0-1000) == simple-clips-text.svg simple-clips-text.svg
test-pref(gfx.webrender.svg-simple-clips,true) ref-pref(gfx.webrender.svg-simple-clips,false) == simple-clips-fragmented.html simple-clips-fragmented.html
