include TaintedCompoundHeader;

[Tainted] struct TaintedStruct {
    int x;
};

struct PlainStruct {
    int x;
};

[Tainted] union TaintedUnion {
    int;
    bool;
};

[ChildProc=any]
protocol PTaintedCompound {
parent:
    async Foo(TaintedStruct a, TaintedStruct? b, TaintedStruct[] c,
              TaintedHeaderStruct d, [NoTaint=passback] TaintedStruct e,
              PlainStruct f, TaintedUnion g, TaintedHeaderUnion h,
              [NoTaint=allvalid] TaintedUnion i);
child:
    async Bar(TaintedStruct a, TaintedUnion b);
};
