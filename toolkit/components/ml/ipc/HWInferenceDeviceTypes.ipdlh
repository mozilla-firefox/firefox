using mozilla::dom::HWInferenceDeviceKind from "mozilla/hwinference/HWInferenceTypes.h";
using mozilla::dom::HWInferenceBackend from "mozilla/hwinference/HWInferenceTypes.h";

namespace mozilla {
namespace hwinference {

// One inference device of the HWInference process, see HWInference.webidl.
struct DeviceDescriptor {
  nsCString id;
  nsCString description;
  HWInferenceDeviceKind kind;
  HWInferenceBackend[] backends;
};

// Fallback order, by devices or by kinds, never both; both empty is the CPU.
struct DevicePlacement {
  nsCString[] devices;
  HWInferenceDeviceKind[] kinds;
};

}  // namespace hwinference
}  // namespace mozilla
