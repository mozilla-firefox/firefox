[
  {
    "namespace": "manifest",
    "types": [
      {
        "id": "WidgetSize",
        "type": "string",
        "enum": ["small", "medium", "large"]
      },
      {
        "id": "BuiltinWidget",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "$ref": "ExtensionURL",
            "description": "Path to the widget content."
          },
          "sizes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "WidgetSize"
            },
            "description": "Sizes the widget can be displayed at."
          },
          "default_size": {
            "$ref": "WidgetSize",
            "optional": true,
            "description": "Size the widget is displayed at until one is chosen. Defaults to the first of sizes."
          },
          "pref_branch": {
            "type": "string",
            "optional": true,
            "pattern": "^[A-Za-z][\\w-]*(\\.[\\w-]+)*$",
            "description": "Pref branch that stores whether the widget is enabled and the size chosen for it, in <pref_branch>.enabled and <pref_branch>.size."
          }
        }
      },
      {
        "id": "GeneratedWidget",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "$ref": "ExtensionURL",
            "description": "Path to the widget content."
          },
          "sizes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "WidgetSize"
            },
            "description": "Sizes the widget can be displayed at."
          },
          "default_size": {
            "$ref": "WidgetSize",
            "optional": true,
            "description": "Size the widget is displayed at until one is chosen. Defaults to the first of sizes."
          }
        }
      },
      {
        "id": "GeneratedWidgetManifest",
        "type": "object",
        "description": "Represents the manifest of a generated widget, built from its widget.json.",
        "$import": "ManifestBase",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 75
          },
          "description": {
            "type": "string",
            "optional": true,
            "maxLength": 2000
          },
          "permissions": {
            "type": "array",
            "optional": true,
            "items": {
              "type": "string",
              "enum": ["storage", "unlimitedStorage", "idle"]
            }
          },
          "optional_permissions": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 0,
            "optional": true,
            "default": []
          },
          "host_permissions": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 0,
            "optional": true,
            "default": []
          },
          "optional_host_permissions": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 0,
            "optional": true,
            "default": []
          },
          "generated_widget": {
            "$ref": "GeneratedWidget"
          }
        }
      },
      {
        "$extend": "WebExtensionManifest",
        "properties": {
          "builtin_widget": {
            "$ref": "BuiltinWidget",
            "optional": true,
            "privileged": true,
            "description": "Declares a widget provided by a privileged extension."
          },
          "generated_widget": {
            "$ref": "GeneratedWidget",
            "optional": true,
            "privileged": true,
            "description": "Declares a widget generated from a prompt. Marked privileged to reserve it for generated widgets, so addons-linter reports it as an error in submissions to AMO. Generated widgets themselves run unprivileged."
          }
        }
      }
    ]
  }
]
