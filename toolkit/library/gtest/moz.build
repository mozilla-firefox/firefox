# Use DIST_SUBDIR rather than FINAL_TARGET so that, on Windows, the import
# library for this "xul" DLL is installed to dist/lib/gtest instead of
# racing with (and clobbering) the real libxul import library in dist/lib.
DIST_SUBDIR = "gtest"

USE_LIBS += [
    "gkrust-gtest",
]

DIRS += [
    "libxul_broken_buildid",
    "libxul_correct_buildid",
    "libxul_missing_buildid",
]

UNIFIED_SOURCES = [
    "TestBuildIDReader.cpp",
]

LOCAL_INCLUDES += [
    "/xpcom/build",
]

USE_LIBS += [
    "static:xul",
]

Libxul(
    "xul-gtest",
    output_category=None if CONFIG["LINK_GTEST_DURING_COMPILE"] else "gtest",
)
