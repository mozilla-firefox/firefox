@template
def SharedLibrary(name):
    FORCE_SHARED_LIB = True
    LIBRARY_NAME = name


SharedLibrary("foo")
SYMBOLS_FILE = "!foo.symbols"

GENERATED_FILES += ["foo.symbols"]
GENERATED_FILES["foo.symbols"].script = "foo.py"

EXTRA_LINK_DEPS += [
    "!generated.rsp",
]
