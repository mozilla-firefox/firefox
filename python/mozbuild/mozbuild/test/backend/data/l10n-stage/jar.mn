#filter substitution
browser.jar:
%  locale testing @AB_CD@ %locale/@AB_CD@/testing/
  locale/@AB_CD@/testing/plain.txt          (en-US/plain.txt)
#if defined(ANDROID_MARKETPLACE_AB_CD)
  locale/@AB_CD@/testing/android.png        (@ANDROID_MARKETPLACE_AB_CD@/android.png)
#else
  locale/@AB_CD@/testing/android.png        (en-US/android.png)
#endif
#if defined(IOS_MARKETPLACE_AB_CD)
  locale/@AB_CD@/testing/ios.svg            (@IOS_MARKETPLACE_AB_CD@/ios.svg)
#else
  locale/@AB_CD@/testing/ios.svg            (en-US/ios.svg)
#endif

#define EN_US en-US
#if AB_CD != EN_US
[localization] @AB_CD@.jar:
  testing/extra                             (%extra.ftl)
#endif
