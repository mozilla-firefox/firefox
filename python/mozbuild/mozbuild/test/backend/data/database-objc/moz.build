@template
def Library(name):
    """Template for libraries."""
    LIBRARY_NAME = name


Library("dummy")

SOURCES = ["baz.m", "qux.mm"]

SOURCE_HEADERS = ["qux.h"]

CMFLAGS += ["-fobjc-arc"]
CMMFLAGS += ["-fobjc-weak"]
