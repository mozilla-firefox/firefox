@template
def HostSharedLibrary(name):
    HOST_LIBRARY_NAME = name
    FORCE_SHARED_LIB = True
    IS_COMPILER_PLUGIN = True


HostSharedLibrary("clang-plugin")

HOST_SOURCES += ["plugin.cpp"]

DIRS += ["tests"]
