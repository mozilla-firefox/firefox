include("/dom/media/webrtc/third_party_build/webrtc.mozbuild")

EXPORTS.mozilla.dom += ["CandidateInfo.h"]

EXPORTS.mozilla += ["IceServerParser.h"]

LOCAL_INCLUDES += [
    "!/dist/include/libwebrtc_overrides",
    "/dom/media/webrtc",
    "/dom/media/webrtc/transport/third_party/nrappkit/src/util/libekr",
    "/third_party/abseil-cpp",
    "/third_party/libwebrtc",
]

UNIFIED_SOURCES += [
    "browser_logging/CSFLog.cpp",
    "browser_logging/WebRtcLog.cpp",
    "IceServerParser.cpp",
    "RandomHex.cpp",
    "RtpHeaderExtensions.cpp",
    "time_profiling/timecard.c",
    "YuvStamper.cpp",
]

FINAL_LIBRARY = "xul"

SOURCE_HEADERS += [
    "CommonTypes.h",
    "csf_common.h",
    "EncodingConstraints.h",
    "NullDeleter.h",
    "RandomHex.h",
    "RtpHeaderExtensions.h",
    "Wrapper.h",
    "YuvStamper.h",
]
