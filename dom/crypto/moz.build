with Files("**"):
    BUG_COMPONENT = ("Core", "DOM: Web Crypto")

EXPORTS.mozilla.dom += [
    "CryptoBuffer.h",
    "CryptoKey.h",
    "KeyAlgorithmProxy.h",
    "WebCryptoCommon.h",
    "WebCryptoTask.h",
]

UNIFIED_SOURCES += [
    "CryptoBuffer.cpp",
    "CryptoKey.cpp",
    "KeyAlgorithmProxy.cpp",
    "WebCryptoTask.cpp",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/security/manager/ssl",
    "/xpcom/build",
]

MOCHITEST_MANIFESTS += ["test/mochitest.toml"]

# Add libFuzzer configuration directives
include("/tools/fuzzing/libfuzzer-config.mozbuild")
