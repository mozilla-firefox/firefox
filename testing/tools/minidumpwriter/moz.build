if CONFIG["ENABLE_TESTS"] and CONFIG["OS_ARCH"] == "WINNT":
    Program("minidumpwriter")
    OS_LIBS += [
        "dbghelp",
    ]
    SOURCES += [
        "minidumpwriter.cpp",
    ]
    USE_STATIC_MSVCRT = True
    WIN32_WIDE_ENTRY = True

NO_PGO = True
