{
  "background": {
    "color": {
      "@base": {
        "value": {
          "nativeTheme": "transparent",
          "default": "{button.background.color.@base}"
        }
      },
      "selected": {
        "value": {
          "nativeTheme": "{toolbar.background.color}",
          "default": "{background.color.box.@base}",
          "forcedColors": "{button.background.color.selected}"
        }
      }
    }
  },
  "border": {
    "color": {
      "@base": {
        "value": {
          "default": "transparent",
          "forcedColors": "{button.border.color.@base}"
        }
      },
      "hover": {
        "value": {
          "default": "transparent",
          "forcedColors": "{button.border.color.hover}"
        }
      },
      "selected": {
        "leading": {
          "value": {
            "default": "{color.violet.30}",
            "forcedColors": "{tab.border.color.selected.@base}"
          }
        },
        "trailing": {
          "value": {
            "default": "{color.orange.30}",
            "forcedColors": "{tab.border.color.selected.@base}"
          }
        }
      }
    }
  },
  "box": {
    "shadow": {
      "selected": {
        "value": "none"
      }
    }
  },
  "margin": {
    "block": {
      "@base": {
        "value": "6px"
      }
    }
  },
  "outline": {
    "offset": {
      "value": "-1px"
    }
  },
  "text": {
    "color": {
      "selected": {
        "value": {
          "nativeTheme": "{toolbar.text.color}",
          "default": "{toolbox.text.color.@base}"
        }
      }
    }
  }
}
