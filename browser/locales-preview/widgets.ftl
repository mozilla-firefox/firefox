# Title of the widgets sidebar panel.
widget-studio-title = Widget Studio

menu-view-widget-studio =
  .label = Widget Studio

sidebar-menu-widget-studio-label =
  .label = Widget Studio

# Heading and description of the "Custom widgets" group in the AI controls
# section of Settings, shown to people who turned on custom widgets in Firefox
# Labs. Custom widgets are small widgets people create from a prompt, for their
# homepage or sidebar.
preferences-ai-controls-custom-widgets-group =
    .label = Custom widgets
    .description = Create widgets to add to your homepage or sidebar. We don’t store your prompts, widgets, or widget data.

# Label of the dropdown in the AI controls section of Settings that makes
# custom widgets available, enabled or blocked.
preferences-ai-controls-custom-widgets-control =
    .label = Custom widgets

# Item in the list of features the "Block AI enhancements?" confirmation
# dialog will block.
preferences-ai-controls-block-confirmation-custom-widgets = Custom widgets
