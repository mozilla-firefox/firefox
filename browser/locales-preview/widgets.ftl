# Title of the widgets sidebar panel.
widget-studio-title = Widget Studio

menu-view-widget-studio =
  .label = Widget Studio

sidebar-menu-widget-studio-label =
  .label = Widget Studio

# Heading and description of the "Custom widgets" group in the AI controls
# section of Settings, shown to people who turned on custom widgets in Firefox
# Labs. Custom widgets are small widgets people create from a prompt, for their
# homepage or sidebar.
preferences-ai-controls-custom-widgets-group =
    .label = Custom widgets
    .description = Create widgets to add to your homepage or sidebar. We don’t store your prompts, widgets, or widget data.

# Label of the dropdown in the AI controls section of Settings that makes
# custom widgets available, enabled or blocked.
preferences-ai-controls-custom-widgets-control =
    .label = Custom widgets

# Item in the list of features the "Block AI enhancements?" confirmation
# dialog will block.
preferences-ai-controls-block-confirmation-custom-widgets = Custom widgets

# Opens the text field for describing a widget to make.
widget-studio-compose-button =
  .title = New widget

# Opens Mozilla Connect to share feedback about custom widgets.
widget-studio-menu-share-feedback = Share Feedback

# Opens the support page about custom widgets.
widget-studio-menu-about = About Custom Widgets

# Text field describing the widget to make.
widget-composer-input =
  .placeholder = Describe a widget
  .aria-label = Describe a widget

# Makes the widget the prompt describes.
widget-composer-submit-button =
  .title = Create widget

# Reminder shown under the text field for describing a widget. Widgets are
# generated by AI, so people should check the result.
widget-composer-disclaimer = Widgets are built with AI. Check that yours works as expected.

# Tip shown once, above the text field for describing a widget, the first
# time someone types in it. It can be dismissed.
widget-composer-tip =
    .heading = More details make better widgets
    .message = Describe what you want it to do, plus any key details, like topics, timeframes, or style. Edit or delete your widget any time.

# Line above the prompt examples in the Widget Studio text field, shown
# while the field is empty.
widget-composer-examples-intro = Start with these examples, or write your own…

## Each message is a starter for a widget, shown as a button above the empty
## text field for describing a widget. .label is the short text on the button.
## .prompt is not shown: script reads it and puts it in the text field when the
## button is pressed, so it is the full prompt for the widget.

widget-composer-example-plants =
  .label = A plant watering schedule
  .prompt = Make a plant watering schedule where I list my plants, how often each needs water, and check off the ones I watered today.
widget-composer-example-fitness =
  .label = A daily fitness tracker
  .prompt = Make a daily fitness tracker where I log my workout type and minutes each day and see my weekly total.
widget-composer-example-trivia =
  .label = A movie trivia quiz
  .prompt = Make a movie trivia quiz with ten multiple-choice questions, a running score, and a new set of questions each time.
widget-composer-example-books =
  .label = A book reading log
  .prompt = Make a book reading log where I add titles, track the page I’m on, and mark books as finished with a star rating.
widget-composer-example-recipe =
  .label = A recipe scaler
  .prompt = Make a recipe scaler where I enter ingredients and amounts, choose how many servings I need, and see the amounts adjust.
widget-composer-example-packing =
  .label = A packing checklist
  .prompt = Make a packing checklist for a trip with sections for clothes, toiletries, and documents, where I can add items and check them off.
widget-composer-example-word =
  .label = A word of the day
  .prompt = Make a word of the day widget that shows a new word each day with its meaning and an example sentence.

##

# Heading of the group in Firefox Labs that holds experiments in the Homepage, for example the custom widgets entry.
experimental-features-group-custom-widgets =
  .label = Homepage

# Custom widgets are widgets that people create by describing them to AI.
experimental-features-custom-widgets =
    .label = Custom widgets
experimental-features-custom-widgets-description = Build your own widgets for { -firefox-home-brand-name } or your sidebar just by describing what you want. For example, a habit tracker, word count tool, or dad joke generator. Each widget stays on your device. We don’t store your prompts, widgets, or widget data, and we don’t use your data to train AI. <a data-l10n-name="connect">Share feedback</a>

## Prompt shown in Widget Studio when nobody is signed in.

widget-studio-sign-in-title = Sign in to create custom widgets
widget-studio-sign-in-description = Build helpful tools for your homepage or sidebar.
widget-studio-sign-in-button =
    .label = Sign in
widget-studio-sign-in-example-heading = Describe your widget. Watch it appear.

# Example of a prompt, shown as decoration. It is not a text field.
widget-studio-sign-in-example-prompt = Make a habit tracker with a calendar

# Decoration only: a small preview of a habit tracker widget.
# Variables:
#   $days (number) - Number of days in a row the habit was completed.
widget-studio-sign-in-calendar-title =
    { $days ->
        [one] Morning workout streak: { $days } day
       *[other] Morning workout streak: { $days } days
    }
# Decoration only: the period the habit tracker preview shows.
widget-studio-sign-in-calendar-period = This month
