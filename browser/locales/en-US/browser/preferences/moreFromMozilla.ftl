    .label = { -mozmonitor-brand-name }
    .description = Find out where your personal info has been exposed online with a free scan.

more-from-moz-mozilla-vpn-card =
    .label = { -mozilla-vpn-brand-name }
    .description = Get extra protection for all apps — not just your browser. Keep your data safe on public Wi-Fi and insecure networks.

more-from-moz-firefox-relay-card =
    .label = { -relay-brand-name }
    .description = Protect your inbox from spam with free email masking.

more-from-moz-mdn-card =
    .label = { -mdn-brand-name }
    .description = Learn web development with free guides and references.

more-from-moz-thunderbird-card =
    .label = { -thunderbird-brand-name }
    .description = Access your email, calendars, and contacts in one fast app.

more-from-moz-firefox-enterprise-card =
    .label = { -firefox-enterprise-brand-name }
    .description = Browser governance for regulated and security-sensitive organizations.

more-from-moz-new-products-card2 =
