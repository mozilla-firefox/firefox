{
  "include": [
    "*.sys.mjs",
    "content/*.mjs",
    "types/*.ts",
    "../tabnotes/types/tabnotes.ts",
    "../../../tools/@types/browser-window.d.ts"
  ],
  "exclude": ["content/drag-and-drop.mjs"],
  "extends": "../../../tools/@types/tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "plugins": [
      {
        "transform": "../../../tools/ts/plugins/checkRootOnly.js",
        "transformProgram": true
      }
    ]
  }
}
