    "Handlers": {
      "type": "object",
      "contentMediaType": "application/json",
      "patternProperties": {
        "^(mimeTypes|extensions|schemes)$": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
