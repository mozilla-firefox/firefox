]

if CONFIG["MOZ_DEFAULT_BROWSER_AGENT"] and CONFIG["OS_ARCH"] == "WINNT":
    DEFINES["MOZ_DEFAULT_BROWSER_AGENT"] = CONFIG["MOZ_DEFAULT_BROWSER_AGENT"]

EXTRA_PP_COMPONENTS += [
    "BrowserComponents.manifest",
]

MOZ_SRC_FILES += [
