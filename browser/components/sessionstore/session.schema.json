{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/openWindow"
      }
    },
    "_closedWindows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/closedWindow"
      }
    },
    "savedGroups": {
      "$comment": "Introduced Firefox 133, bug 1908423",
      "type": "array",
      "items": {
        "$ref": "#/definitions/savedTabGroup"
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "lastUpdate": {
          "type": "integer"
        },
        "startTime": {
          "type": "integer"
        },
        "recentCrashes": {
          "type": "integer"
        }
      }
    },
    "global": {
      "type": "object"
    },
    "cookies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/cookie"
      }
    },
    "browserConsole": {
      "type": "boolean"
    },
    "browserToolbox": {
      "type": "boolean"
    },
    "selectedWindow": {
      "type": "integer"
    },
    "maxSplitViewId": {
      "type": "integer"
    }
  },
  "required": ["version", "windows"],
  "unevaluatedProperties": false,
  "definitions": {
    "cookie": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "secure": {
          "type": "boolean"
        },
        "httponly": {
          "type": "boolean"
        },
        "expiry": {
          "type": "integer"
        },
        "originAttributes": {
          "type": "object",
          "properties": {
            "firstPartyDomain": {
              "type": "string"
            },
            "geckoViewSessionContextId": {
              "type": "string"
            },
            "partitionKey": {
              "type": "string"
            },
            "privateBrowsingId": {
              "type": "integer"
            },
            "userContextId": {
              "type": "integer"
            }
          }
        },
        "sameSite": {
          "type": "integer"
        },
        "schemeMap": {
          "type": "integer"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "command": {
          "type": ["null", "string"]
        },
        "panelOpen": {
          "type": "boolean"
        },
        "panelWidth": {
          "type": ["null", "number"]
        },
        "userLauncherVisible": {
          "type": "boolean"
        },
        "launcherExpanded": {
          "type": "boolean"
        },
        "launcherWidth": {
          "type": ["null", "number"]
        },
        "launcherVisible": {
          "$comment": "Removed Firefox 160, bug 2066086",
          "deprecated": true,
          "type": "boolean"
        },
        "bookmarksExpandedFolders": {
          "$comment": "Introduced Firefox 151, bug 2019583",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expandedLauncherWidth": {
          "$comment": "Introduced Firefox 135, bug 1930199",
          "type": ["null", "number"]
        },
        "pinnedTabsHeight": {
          "$comment": "Introduced Firefox 140, bug 1941189",
          "type": "number"
        },
        "expandedPinnedTabsHeight": {
          "$comment": "Introduced Firefox 140, bug 1941189",
          "type": "number"
        },
        "collapsedPinnedTabsHeight": {
          "$comment": "Introduced Firefox 140, bug 1941189",
          "type": "number"
        },
        "toolsHeight": {
          "$comment": "Introduced Firefox 141, bug 1954155",
          "type": "number"
        },
        "expandedToolsHeight": {
          "$comment": "Introduced Firefox 141, bug 1954155",
          "type": "number"
        },
        "collapsedToolsHeight": {
          "$comment": "Introduced Firefox 141, bug 1954155",
          "type": "number"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "extData": {
          "type": "object"
        },
        "sidebar": {
          "$ref": "#/definitions/sidebar"
        },
        "selected": {
          "type": "integer"
        },
        "splitViews": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/splitview"
          }
        },
        "title": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tab"
          }
        },
        "_closedTabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/closedTab",
            "required": ["sourceWindowId"]
          }
        },
        "_lastClosedTabGroupCount": {
          "type": "integer"
        },
        "_shouldRestore": {
          "$comment": "Introduced Firefox 7, bug 625016",
          "type": "boolean"
        },
        "closedAt": {
          "$comment": "Introduced Firefox 29, bug 873556",
          "type": "integer"
        },
        "closedId": {
          "$comment": "Introduced Firefox 52, bug 1309880",
          "type": "integer"
        },
        "groups": {
          "$comment": "Introduced Firefox 133, bug 1908418",
          "description": "A closed window holds its groups as saved groups, and keeps them when it is reopened at startup",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/openTabGroup"
              },
              {
                "$ref": "#/definitions/savedTabGroup"
              }
            ]
          }
        },
        "closedGroups": {
          "$comment": "Introduced Firefox 134, bug 1908422",
          "type": "array",
          "items": {
            "$ref": "#/definitions/closedTabGroup"
          }
        },
        "lastClosedTabGroupId": {
          "$comment": "Introduced Firefox 136, bug 1940752",
          "type": ["null", "string"]
        },
        "args": {
          "$comment": "Introduced Firefox 156, bug 2066315",
          "description": "Arguments to supply to nsIWindowWatcher.openWindow in order to restore a window's previous state",
          "type": "object",
          "properties": {
            "web-extension-popup-window": {
              "description": "Popup window opened by WebExtensions",
              "type": "boolean"
            },
            "chromeless-window": {
              "description": "Window with minimal chrome UI",
              "type": "boolean"
            }
          }
        },
        "chromeFlags": {
          "$comment": "Introduced Firefox 99, bug 1728800",
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "hidden": {
          "$comment": "Removed Firefox 156, bug 2065228",
          "deprecated": true,
          "type": "string"
        },
        "isAIWindow": {
          "type": "boolean"
        },
        "isPopup": {
          "type": "boolean"
        },
        "screenX": {
          "type": "integer"
        },
        "screenY": {
          "type": "integer"
        },
        "sizemode": {
          "type": "string",
          "enum": ["normal", "maximized", "minimized", "fullscreen"]
        },
        "sizemodeBeforeMinimized": {
          "type": "string",
          "enum": ["normal", "maximized", "minimized", "fullscreen"]
        },
        "width": {
          "type": "integer"
        },
        "zIndex": {
          "type": "integer"
        },
        "workspaceID": {
          "type": ["null", "string"]
        }
      },
      "required": ["tabs"]
    },
    "openWindow": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/window"
        }
      ],
      "properties": {
        "__lastSessionWindowID": {
          "type": "string"
        },
        "busy": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "closedWindow": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/window"
        }
      ],
      "required": ["closedId"],
      "unevaluatedProperties": false
    },
    "splitview": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "numberOfTabs": {
          "type": "integer"
        }
      },
      "required": ["id", "numberOfTabs"],
      "unevaluatedProperties": false
    },
    "tab": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entry"
          }
        },
        "removeAfterRestore": {
          "type": "boolean"
        },
        "lastAccessed": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        },
        "searchMode": {
          "$comment": "Introduced Firefox 83, bug 1655486",
          "type": ["null", "object"],
          "properties": {
            "engineName": {
              "type": "string"
            },
            "isGeneralPurposeEngine": {
              "type": "boolean"
            },
            "source": {
              "type": "integer"
            },
            "entry": {
              "type": "string"
            },
            "isPreview": {
              "type": "boolean"
            },
            "restrictType": {
              "type": "string",
              "enum": ["keyword", "symbol"]
            }
          },
          "unevaluatedProperties": false
        },
        "userContextId": {
          "type": "integer"
        },
        "attributes": {
          "type": "object"
        },
        "index": {
          "type": "integer"
        },
        "requestedIndex": {
          "type": "integer"
        },
        "image": {
          "type": ["null", "string"]
        },
        "storage": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "canonicalUrl": {
          "type": "string"
        },
        "splitViewId": {
          "$comment": "Introduced Firefox 149, bug 1995818",
          "type": "integer"
        },
        "formdata": {
          "$comment": "Introduced Firefox 29, bug 947212",
          "$ref": "#/definitions/formdata"
        },
        "scroll": {
          "$comment": "Introduced Firefox 29, bug 921942",
          "$ref": "#/definitions/scroll"
        },
        "pinned": {
          "$comment": "Introduced Firefox 4, bug 575560",
          "type": "boolean"
        },
        "extData": {
          "$comment": "Introduced Firefox 3, bug 328162",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "groupId": {
          "$comment": "Introduced Firefox 133, bug 1908418",
          "type": "string"
        },
        "userTypedValue": {
          "$comment": "Introduced Firefox 3.5, bug 439675",
          "type": "string"
        },
        "userTypedClear": {
          "$comment": "Introduced Firefox 4, bug 522545",
          "type": "integer"
        }
      },
      "required": ["entries"],
      "unevaluatedProperties": false
    },
    "openTab": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/tab"
        }
      ]
    },
    "closedTab": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/definitions/tab"
        },
        "closedInGroup": {
          "type": "boolean"
        },
        "removeAfterRestore": {},
        "permanentKey": {
          "type": "object"
        },
        "title": {
          "type": "string"
        },
        "image": {
          "type": ["null", "string"]
        },
        "pos": {
          "type": "integer"
        },
        "closedAt": {
          "type": "integer"
        },
        "closedId": {
          "type": "integer"
        },
        "sourceWindowId": {
          "description": "The ID of the window the tab was closed in, or the closedId of that window once it has closed too",
          "type": ["integer", "string"]
        },
        "closedInTabGroupId": {
          "$comment": "Introduced Firefox 136, bug 1940752",
          "type": ["null", "string"]
        },
        "_originalStateIndex": {
          "$comment": "Introduced Firefox 135, bug 1927774",
          "type": "integer"
        },
        "_originalGroupStateIndex": {
          "$comment": "Introduced Firefox 135, bug 1927774",
          "type": "integer"
        }
      },
      "required": ["state", "closedId"],
      "unevaluatedProperties": false
    },
    "tabGroup": {
      "$comment": "Introduced Firefox 133, bug 1908418",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "enum": [
            "blue",
            "purple",
            "cyan",
            "orange",
            "yellow",
            "pink",
            "green",
            "gray",
            "red"
          ]
        },
        "collapsed": {
          "type": "boolean"
        },
        "saveOnWindowClose": {
          "type": "boolean"
        }
      },
      "required": ["id"]
    },
    "openTabGroup": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/tabGroup"
        }
      ],
      "unevaluatedProperties": false
    },
    "closedTabGroup": {
      "$comment": "Introduced Firefox 134, bug 1908422",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/tabGroup"
        }
      ],
      "properties": {
        "closedAt": {
          "type": "integer"
        },
        "sourceWindowId": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/closedTab",
            "required": ["sourceWindowId"]
          }
        },
        "splitViews": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/splitview"
          }
        }
      },
      "required": ["tabs"],
      "unevaluatedProperties": false
    },
    "savedTabGroup": {
      "$comment": "Introduced Firefox 133, bug 1908423",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/tabGroup"
        }
      ],
      "properties": {
        "saved": {
          "const": true
        },
        "closedAt": {
          "type": "integer"
        },
        "sourceWindowId": {
          "type": "string"
        },
        "windowClosedId": {
          "type": "integer"
        },
        "removeAfterRestore": {
          "type": "boolean"
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/closedTab"
          }
        },
        "splitViews": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/splitview"
          }
        }
      },
      "required": ["tabs"],
      "unevaluatedProperties": false
    },
    "formdata": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "id": {
          "type": "object"
        },
        "xpath": {
          "type": "object"
        },
        "innerHTML": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/formdata"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "unevaluatedProperties": false
    },
    "scroll": {
      "type": "object",
      "properties": {
        "scroll": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/scroll"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "unevaluatedProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subframe": {
          "type": "boolean"
        },
        "persist": {
          "type": "boolean"
        },
        "principalToInherit_base64": {
          "type": "string"
        },
        "scrollRestorationIsManual": {
          "type": "boolean"
        },
        "hasUserInteraction": {
          "type": "boolean"
        },
        "triggeringPrincipal_base64": {
          "type": "string"
        },
        "resultPrincipalURI": {
          "type": ["null", "string"]
        },
        "scroll": {
          "type": "string"
        },
        "presState": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/presStateItem"
          }
        },
        "loadReplace": {
          "type": "boolean"
        },
        "loadReplace2": {
          "type": "boolean"
        },
        "csp": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "cacheKey": {
          "type": "integer"
        },
        "ID": {
          "type": "integer"
        },
        "srcdocData": {
          "type": "string"
        },
        "isSrcdocEntry": {
          "type": "boolean"
        },
        "baseURI": {
          "type": "string"
        },
        "docIdentifier": {
          "type": "integer"
        },
        "structuredCloneState": {
          "type": "string"
        },
        "structuredCloneVersion": {
          "type": "integer"
        },
        "docshellUUID": {
          "type": "string"
        },
        "referrerInfo": {
          "type": "string"
        },
        "originalURI": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entry"
          }
        },
        "policyContainer": {
          "type": "string"
        },
        "transient": {
          "type": "boolean"
        },
        "navigationKey": {
          "type": "string"
        },
        "navigationId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["url"]
    },
    "presStateItem": {
      "type": "object",
      "properties": {
        "stateKey": {
          "type": "string"
        },
        "scroll": {
          "type": "string"
        }
      }
    }
  }
}
