DisableStlWrapping()

GeckoCppUnitTests(
    [
        "TestCrossProcessWin",
        "TestSafeThreadLocal",
        "TestSameBinary",
    ],
    linkage=None,
)

LOCAL_INCLUDES += [
    "/browser/app/winlauncher",
]

OS_LIBS += [
    "advapi32",
    "ntdll",
]

WIN32_WIDE_ENTRY = True
