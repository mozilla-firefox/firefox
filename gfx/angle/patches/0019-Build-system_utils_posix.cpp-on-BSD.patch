From cb5bd3e492b7931b8672ed96e11e908f33e59ae9 Mon Sep 17 00:00:00 2001
From: Jamie Nicol <jnicol@mozilla.com>
Date: Thu, 5 Nov 2026 15:46:21 +0000
Subject: [PATCH] Build system_utils_posix.cpp on BSD

Avoids undefined symbol errors at startup on OpenBSD.
---
 src/libGLESv2.gni | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/libGLESv2.gni b/src/libGLESv2.gni
index 24fcdb4014..0fa8edef2a 100644
--- a/src/libGLESv2.gni
+++ b/src/libGLESv2.gni
@@ -133,6 +133,10 @@ if (is_linux || is_chromeos || is_android || is_fuchsia) {
   ]
 }
 
+if (is_bsd) {
+  libangle_common_sources += [ "src/common/system_utils_posix.cpp" ]
+}
+
 if (is_linux || is_chromeos) {
   libangle_common_sources += [
     "src/common/linux/window_system.cpp",
-- 
