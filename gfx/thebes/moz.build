if CONFIG["MOZ_WIDGET_TOOLKIT"] == "android":
    EXPORTS += [
        "gfxAndroidPlatform.h",
        "gfxFT2FontBase.h",
        "gfxFT2Fonts.h",
    ]
    SOURCES += [
        "gfxAndroidPlatform.cpp",
        "gfxFT2FontBase.cpp",
        "gfxFT2FontList.cpp",
        "gfxFT2Fonts.cpp",
        "gfxFT2Utils.cpp",
    ]

    SOURCE_HEADERS += [
        "gfxFT2FontList.h",
        "gfxFT2Utils.h",
    ]

    UNIFIED_SOURCES += [
        "AndroidSystemFontIterator.cpp",
    ]
    SOURCE_HEADERS += [
        "AndroidSystemFontIterator.h",
    ]
elif CONFIG["MOZ_WIDGET_TOOLKIT"] in ("cocoa", "uikit"):
    EXPORTS += [
        "gfxMacUtils.h",
        "gfxPlatformMac.h",
        "gfxQuartzNativeDrawing.h",
        "gfxQuartzSurface.h",
    ]
    SOURCES += [
        "CoreTextFontList.cpp",
        "gfxCoreTextShaper.cpp",
        "gfxMacFont.cpp",
        "gfxMacUtils.cpp",
        "gfxPlatformMac.cpp",
        "gfxQuartzNativeDrawing.cpp",
        "gfxQuartzSurface.cpp",
    ]

    SOURCE_HEADERS += [
        "CoreTextFontList.h",
        "gfxCoreTextShaper.h",
        "gfxMacFont.h",
    ]
elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    EXPORTS += [
        "gfxFT2FontBase.h",
        "gfxPlatformGtk.h",
    ]
    SOURCES += [
        "gfxFcPlatformFontList.cpp",
        "gfxFT2FontBase.cpp",
        "gfxFT2Utils.cpp",
        "gfxPlatformGtk.cpp",
    ]

    SOURCE_HEADERS += [
        "gfxFcPlatformFontList.h",
        "gfxFT2FontList.h",
        "gfxFT2Utils.h",
    ]

    if CONFIG["MOZ_X11"]:
        EXPORTS += [
            "gfxXlibSurface.h",
        ]
        EXPORTS.mozilla.gfx += [
            "XlibDisplay.h",
        ]
        SOURCES += [
            "gfxXlibSurface.cpp",
            "XlibDisplay.cpp",
        ]

elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
    EXPORTS += [
        "gfxDWriteCommon.h",
        "gfxDWriteFonts.h",
        "gfxWindowsPlatform.h",
        "gfxWindowsSurface.h",
    ]
    EXPORTS.mozilla.gfx += [
        "DeviceManagerDx.h",
        "DisplayConfigWindows.h",
        "PrintTargetWindows.h",
    ]
    SOURCES += [
        "DisplayConfigWindows.cpp",
        "gfxDWriteCommon.cpp",
        "gfxDWriteFonts.cpp",
        "gfxWindowsPlatform.cpp",
        "gfxWindowsSurface.cpp",
        "PrintTargetWindows.cpp",
    ]
    UNIFIED_SOURCES += [
        "gfxDWriteFontList.cpp",
    ]
    SOURCE_HEADERS += [
        "d3dkmtQueryStatistics.h",
        "gfxDWriteFontList.h",
    ]

SOURCES += [
    # Includes mac system header conflicting with point/size,
    # and includes glxXlibSurface.h which drags in Xrender.h
    "gfxASurface.cpp",
    # on X11, gfxDrawable.cpp includes X headers for an old workaround which
    # we could consider removing soon (affects Ubuntus older than 10.04 LTS)
    # which currently prevent it from joining UNIFIED_SOURCES.
    "gfxDrawable.cpp",
    # gfxFontUtils.cpp and gfxPlatform.cpp include mac system header conflicting with point/size
    "gfxFontUtils.cpp",
    "gfxPlatform.cpp",
    "PrintTarget.cpp",
]

