    UNIFIED_SOURCES += [
        "gfxMacPlatformFontList.mm",
    ]

    SOURCE_HEADERS += [
        "gfxMacPlatformFontList.h",
    ]
elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "uikit":
    UNIFIED_SOURCES += [
        "IOSPlatformFontList.mm",
