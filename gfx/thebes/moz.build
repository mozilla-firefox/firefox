    UNIFIED_SOURCES += [
        "D3D11Checks.cpp",
        "DeviceManagerDx.cpp",
    ]

# We use ICU for normalization functions:
USE_LIBS += [
    "icu",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "!/security/rlbox",
    "/dom/base",
    "/dom/media/platforms/apple",
    "/dom/xml",
    "/gfx/cairo/cairo/src",
    "/image/encoders/jpeg",
    "/widget/gtk",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] in ("android", "gtk"):
    DEFINES["MOZ_ENABLE_FREETYPE"] = True

if CONFIG["MOZ_WIDGET_TOOLKIT"] in ("android"):
    CXXFLAGS += CONFIG["CAIRO_FT_CFLAGS"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
    CFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
    CXXFLAGS += CONFIG["MOZ_PANGO_CFLAGS"]

if CONFIG["MOZ_WAYLAND"]:
    CXXFLAGS += CONFIG["MOZ_WAYLAND_CFLAGS"]

LOCAL_INCLUDES += CONFIG["SKIA_INCLUDES"]

DEFINES["GRAPHITE2_STATIC"] = True

COMPILE_FLAGS["WARNINGS_CXXFLAGS"] += ["-Werror=switch"]

include("/tools/fuzzing/libfuzzer-config.mozbuild")

LICENSES += ["icu"]
LICENSES["icu"].title = "ICU License"
LICENSES["icu"].text = "LICENSE-NOTICE.txt"
LICENSES["icu"].spdx = "ICU"
LICENSES["icu"].notice = """
<p>This license applies to some code in the <code>gfx/thebes</code> directory.</p>
"""

LICENSED_UNDER += [
    "icu",
]

LICENSED_UNDER += ["gfx-font-list"]
LICENSED_UNDER["gfx-font-list"].paths = [
    "gfxMacPlatformFontList.mm",
    "gfxPlatformFontList.cpp",
]

SOURCE_HEADERS += [
    "cairo-xlib-utils.h",
    "gfxFontMissingGlyphs.h",
    "gfxGlyphExtents.h",
    "gfxGraphiteShaper.h",
    "gfxHarfBuzzShaper.h",
    "SharedFontList-impl.h",
]
