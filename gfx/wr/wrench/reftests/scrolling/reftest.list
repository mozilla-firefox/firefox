scale(*) == empty-mask.yaml empty-mask-ref.yaml
# At fractional scales the snapped scroll offset of the clip's scroll frame ends
# up half a device pixel above the unscrolled reference, so the clipped edge
# lands one device pixel short.
scale(1,2) == fixed-position-scrolling-clip.yaml fixed-position-scrolling-clip-ref.yaml
# At fractional scales the perspective reference frame's content is not snapped
# like the reference's, so its right edge covers one extra device pixel column.
