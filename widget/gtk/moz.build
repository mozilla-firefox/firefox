XPCOM_MANIFESTS += [
    "components.conf",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/layout/base",
    "/layout/forms",
    "/layout/generic",
    "/layout/xul",
    "/other-licenses/atk-1.0",
    "/third_party/cups/include",
    "/widget",
    "/widget/headless",
    "/widget/x11",
]

CXXFLAGS += CONFIG["MOZ_GBM_CFLAGS"]
if not CONFIG["MOZ_SYSTEM_GBM"]:
    LOCAL_INCLUDES += [
        "/third_party/gbm/gbm/",
    ]
    DIRS += [
        "/third_party/gbm/gbm/",
    ]

CXXFLAGS += CONFIG["MOZ_LIBDRM_CFLAGS"]
if not CONFIG["MOZ_SYSTEM_LIBDRM"]:
    LOCAL_INCLUDES += [
        "/third_party/drm/drm/",
        "/third_party/drm/drm/include",
        "/third_party/drm/drm/include/libdrm",
    ]

DEFINES["CAIRO_GFX"] = True

DEFINES["MOZ_APP_NAME"] = '"%s"' % CONFIG["MOZ_APP_NAME"]

CFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]

if CONFIG["MOZ_WAYLAND"]:
    CFLAGS += CONFIG["MOZ_WAYLAND_CFLAGS"]
    CXXFLAGS += CONFIG["MOZ_WAYLAND_CFLAGS"]

if CONFIG["MOZ_ENABLE_DBUS"]:
    EXPORTS.mozilla.widget += [
        "AsyncDBus.h",
    ]
    UNIFIED_SOURCES += [
        "AsyncDBus.cpp",
        "DBusMenu.cpp",
        "DBusService.cpp",
    ]
    SOURCE_HEADERS += [
        "DBusMenu.h",
        "DBusService.h",
    ]
    CXXFLAGS += CONFIG["MOZ_DBUS_CFLAGS"]

if CONFIG["MOZ_WAYLAND"] and CONFIG["MOZ_ENABLE_DBUS"]:
    UNIFIED_SOURCES += [
        "FileTransferPortal.cpp",
    ]
    SOURCE_HEADERS += [
        "FileTransferPortal.h",
    ]

COMPILE_FLAGS["WARNINGS_CXXFLAGS"] += ["-Werror=switch"]

