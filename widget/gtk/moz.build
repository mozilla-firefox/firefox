if CONFIG["MOZ_X11"]:
    UNIFIED_SOURCES += [
        "nsShmImage.cpp",
        "RetrievalContextX11.cpp",
        "WindowSurfaceX11.cpp",
        "WindowSurfaceX11Image.cpp",
        "WindowSurfaceX11SHM.cpp",
    ]
    SOURCES += [
        "nsWindowX11.cpp",  # conflicts with X11 headers
