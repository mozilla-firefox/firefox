]

SOURCES += [
    "MediaKeysEventSourceFactory.cpp",
    "nsNativeThemeGTK.cpp",  # conflicts with X11 headers
    "nsWindow.cpp",  # conflicts with X11 headers
]

if CONFIG["MOZ_WAYLAND"]:
    UNIFIED_SOURCES += [
        "MozContainerWayland.cpp",
        "nsDragServiceWayland.cpp",
        "nsWaylandDisplay.cpp",
        "RetrievalContextGtk.cpp",
        "RetrievalContextWayland.cpp",
        "WaylandBuffer.cpp",
        "WaylandSurface.cpp",
        "WindowSurfaceCairo.cpp",
        "WindowSurfaceWaylandMultiBuffer.cpp",
    ]
    SOURCES += [
        "nsWindowWayland.cpp",  # conflicts with X11 headers
        "WaylandVsyncSource.cpp",  # conflicts with X11 headers
    ]
    SOURCE_HEADERS += [
        "nsDragServiceWayland.h",
        "nsWindowWayland.h",
        "RetrievalContextGtk.h",
        "RetrievalContextWayland.h",
        "WaylandVsyncSource.h",
        "WindowSurfaceCairo.h",
        "WindowSurfaceWaylandMultiBuffer.h",
