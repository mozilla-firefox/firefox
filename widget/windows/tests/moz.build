GeckoCppUnitTests(
    [
        "TestUriValidation",
    ],
    linkage=None,
)

DIRS = ["gtest"]

LOCAL_INCLUDES += []

OS_LIBS += [
    "oleaut32",
    "ole32",
    "shell32",
    "shlwapi",
    "urlmon",
    "uuid",
]

WIN32_WIDE_ENTRY = True

BROWSER_CHROME_MANIFESTS += ["browser/browser.toml"]
XPCSHELL_TESTS_MANIFESTS += ["unit/xpcshell.toml"]

SOURCE_HEADERS += [
    "TestUrisToValidate.h",
]
