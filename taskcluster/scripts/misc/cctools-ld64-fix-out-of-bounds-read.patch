From f178f57fd2fbf1e94dc3eca5720414f5e670def2 Mon Sep 17 00:00:00 2001
From: Mike Hommey <mh@glandium.org>
Date: Sat, 7 Nov 2026 10:37:18 +0000
Subject: [PATCH] Fix out-of-bounds read when a string fills a string pool
 buffer to its end

When adding a string in the String Pool and copying the string happens to
finish filling the current string pool buffer, the current code would properly
prepare a new buffer for the next strings, but would also fill a few bytes with
whatever follows the trailing NUL character from the current string
(effectively an out-of-bounds read).
---
 cctools/ld64/src/ld/LinkEditClassic.hpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/cctools/ld64/src/ld/LinkEditClassic.hpp b/cctools/ld64/src/ld/LinkEditClassic.hpp
index c997a7a..925eee4 100644
--- a/cctools/ld64/src/ld/LinkEditClassic.hpp
+++ b/cctools/ld64/src/ld/LinkEditClassic.hpp
@@ -150,6 +150,13 @@ int32_t StringPoolAtom::add(const char* str)
 	if ( (_currentBufferUsed+lenNeeded) < kBufferSize ) {
 		_currentBufferUsed += lenNeeded;
 	}
+	else if ( (_currentBufferUsed+lenNeeded) == kBufferSize ) {
+		// the copy ended with trailing '\0' at the end of the current buffer.
+		// we just allocate the next buffer
+		_fullBuffers.push_back(_currentBuffer);
+		_currentBuffer = new char[kBufferSize];
+		_currentBufferUsed = 0;
+	}
 	else {
 		int copied = kBufferSize-_currentBufferUsed-1;
 		// change trailing '\0' that strlcpy added to real char
